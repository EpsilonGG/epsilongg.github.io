---
/**
 * 页脚右侧「联系 / RSS」小图标 + 联系面板。
 *
 * - 两个图标落在真正的页脚（版权文字那一行）右侧，尺寸跟随页脚小字，无边框。
 * - 点信封按钮，底部上滑一块约 2/3 视口高的面板：左半是联系方式与个人简介 +
 *   大型 mailto 按钮，右半是问卷式表单（称呼 / 邮箱选填，内容必填）。
 * - 表单提交时按发送当天的本地日期生成匿名称呼（称呼留空时），随后用 mailto
 *   发往本站邮箱：主题＝称呼，正文＝留言内容，末尾附填写邮箱的 mailto 链接。
 *   按钮显示 5 秒「收到👌」后复原，期间屏蔽重复点击（面板内不再放 mailto 限制说明）。
 * - 面板遵循 note-popover 的交互：Esc 关闭、点遮罩关闭、关闭后焦点回到触发按钮。
 */
import { profile } from '../config/profile';

const contactEmail = profile.email;
const directMailto = `mailto:${contactEmail}?subject=${encodeURIComponent(`联系 ${profile.name}`)}`;
---

<div class="contact-links">
  <button
    class="contact-link"
    type="button"
    data-contact-open
    aria-label="联系"
    aria-expanded="false"
    aria-controls="contact-sheet"
    title="联系"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2.8" y="5" width="18.4" height="14" rx="2"></rect>
      <path d="M3.2 6.2 12 13l8.8-6.8"></path>
    </svg>
  </button>
  <a
    class="contact-link"
    href="/rss.xml"
    aria-label="RSS 订阅"
    title="RSS"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="5.2" cy="18.8" r="1.6" fill="currentColor" stroke="none"></circle>
      <path d="M3.6 11.6a8.8 8.8 0 0 1 8.8 8.8"></path>
      <path d="M3.6 5.2a15.2 15.2 0 0 1 15.2 15.2"></path>
    </svg>
  </a>
</div>

<div class="contact-backdrop" data-contact-backdrop hidden></div>

<div
  class="contact-sheet"
  id="contact-sheet"
  data-contact-sheet
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-sheet-title"
  hidden
>
  <button class="contact-sheet__close" type="button" data-contact-close aria-label="关闭联系面板">×</button>

  <div class="contact-sheet__grid">
    <section class="contact-sheet__about">
      <p class="contact-sheet__eyebrow">CONTACT · 联系方式</p>
      <div class="contact-sheet__identity">
        {profile.avatar && <img class="contact-sheet__avatar" src={profile.avatar} alt="" />}
        <div>
          <h2 id="contact-sheet-title">{profile.name}</h2>
          <p class="contact-sheet__tagline">{profile.tagline}</p>
        </div>
      </div>
      <ul class="contact-sheet__intro">
        {profile.intro.map((line) => <li>{line}</li>)}
      </ul>
      <a class="contact-sheet__mailto" href={directMailto}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <rect x="2.8" y="5" width="18.4" height="14" rx="2"></rect>
          <path d="M3.2 6.2 12 13l8.8-6.8"></path>
        </svg>
        <span>直接写邮件<small>{contactEmail}</small></span>
      </a>
    </section>

    <section class="contact-sheet__form-wrap">
      <form data-contact-form data-contact-email={contactEmail}>
        <label>
          称呼
          <input type="text" name="visitor" autocomplete="name" placeholder="选填" />
        </label>
        <label>
          邮箱
          <input type="email" name="replyto" autocomplete="email" placeholder="选填" />
        </label>
        <label>
          留言内容 <small>必填</small>
          <textarea name="message" required rows="6" placeholder="想说的话写在这里"></textarea>
        </label>
        <button class="contact-sheet__submit" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2.8" y="5" width="18.4" height="14" rx="2"></rect>
            <path d="M3.2 6.2 12 13l8.8-6.8"></path>
          </svg>
          <span data-submit-label>发送</span>
        </button>
      </form>
    </section>
  </div>
</div>

<script>
  const openButton = document.querySelector<HTMLButtonElement>('[data-contact-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-contact-close]');
  const backdrop = document.querySelector<HTMLElement>('[data-contact-backdrop]');
  const sheet = document.querySelector<HTMLElement>('[data-contact-sheet]');
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const submitLabel = form?.querySelector<HTMLElement>('[data-submit-label]');
  /** 发送后 5 秒内的二次点击不再重复拉起邮件客户端。 */
  let justSent = false;
  let feedbackTimer = 0;

  if (openButton && closeButton && backdrop && sheet && form) {
    let previousOverflow = '';

    const focusables = () =>
      Array.from(
        sheet.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );

    function open(): void {
      if (!sheet || !backdrop || !openButton) return;
      previousOverflow = document.documentElement.style.overflow;
      sheet.hidden = false;
      backdrop.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      openButton.setAttribute('aria-expanded', 'true');
      const first = form?.querySelector<HTMLInputElement>('input[name="visitor"]');
      first?.focus({ preventScroll: true });
    }

    function close(): void {
      if (!sheet || !backdrop || !openButton) return;
      sheet.hidden = true;
      backdrop.hidden = true;
      document.documentElement.style.overflow = previousOverflow;
      openButton.setAttribute('aria-expanded', 'false');
      openButton.focus({ preventScroll: true });
    }

    openButton.addEventListener('click', () => {
      if (sheet?.hidden) open();
      else close();
    });
    closeButton.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (event) => {
      if (!sheet || sheet.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key === 'Tab') {
        const items = focusables();
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (justSent) return;
      const data = new FormData(form);
      const message = String(data.get('message') ?? '').trim();
      if (!message) {
        form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')?.focus();
        return;
      }

      justSent = true;
      if (submitLabel) submitLabel.textContent = '收到👌';
      window.clearTimeout(feedbackTimer);
      feedbackTimer = window.setTimeout(() => {
        if (submitLabel) submitLabel.textContent = '发送';
        justSent = false;
      }, 5000);

      const visitor = String(data.get('visitor') ?? '').trim() || `【${date}_匿名】`;
      const replyto = String(data.get('replyto') ?? '').trim();

      /* 主题只放称呼；正文只放留言，末尾在填写了邮箱时附一个 mailto 链接。 */
      const body = replyto ? `${message}\n\nmailto:${replyto}` : message;
      const href =
        `mailto:${form.dataset.contactEmail ?? ''}` +
        `?subject=${encodeURIComponent(visitor)}` +
        `&body=${encodeURIComponent(body)}`;
      window.location.href = href;
    });
  }
</script>

<style>
  .contact-links {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-text-muted);
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease);
  }
  .contact-link:hover,
  .contact-link:focus-visible {
    color: var(--color-text);
  }
  .contact-link svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .contact-backdrop {
    position: fixed;
    inset: 0;
    z-index: 59;
    background: rgb(0 0 0 / 42%);
  }
  .contact-backdrop[hidden],
  .contact-sheet[hidden] {
    display: none;
  }

  .contact-sheet {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    height: min(64vh, 640px);
    overflow-y: auto;
    padding: var(--space-5) var(--page-padding) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    background: var(--color-bg);
    border-top: var(--border-width) solid var(--color-border-strong);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 -12px 40px rgb(0 0 0 / 12%);
    animation: contact-sheet-in var(--duration) var(--ease);
  }
  @keyframes contact-sheet-in {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: none; }
  }

  .contact-sheet__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 4px;
    background: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .contact-sheet__close:hover {
    color: var(--color-text);
  }

  .contact-sheet__grid {
    max-width: var(--page-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-6);
  }

  .contact-sheet__eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .contact-sheet__identity {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .contact-sheet__avatar {
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-round);
    object-fit: cover;
    border: var(--border-width) solid var(--color-border);
  }
  .contact-sheet h2 {
    margin: 0;
    font-size: var(--text-lg);
  }
  .contact-sheet__tagline {
    margin: 0.15rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .contact-sheet__intro {
    margin: var(--space-3) 0 0;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .contact-sheet__intro li {
    margin: 0.2rem 0;
  }
  .contact-sheet__mailto {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-4);
    padding: 0.85rem 1.15rem;
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: var(--text-md);
    font-weight: 600;
    text-decoration: none;
  }
  .contact-sheet__mailto:hover {
    background: var(--color-tile-bg);
    color: var(--color-tile-text);
  }
  .contact-sheet__mailto svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
  }
  .contact-sheet__mailto small {
    display: block;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .contact-sheet__form-wrap label {
    display: block;
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .contact-sheet__form-wrap label small {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .contact-sheet input,
  .contact-sheet textarea {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.6rem 0.75rem;
    font: inherit;
    font-size: var(--text-base);
    color: var(--color-text);
    background: var(--color-bg-subtle);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius);
  }
  .contact-sheet textarea {
    min-height: 7rem;
    resize: vertical;
  }
  .contact-sheet input:focus,
  .contact-sheet textarea:focus {
    outline: 2px solid var(--color-text-secondary);
    outline-offset: 1px;
  }
  /* 与「直接写邮件」同款：描边、var(--radius) 圆角、小信封图标；
     padding 沿用原来的 .7rem 1.6rem，占位不变（文字短了，补上图标）。 */
  .contact-sheet__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.6rem;
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .contact-sheet__submit svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  .contact-sheet__submit:hover {
    background: var(--color-tile-bg);
    color: var(--color-tile-text);
  }

  @media (max-width: 760px) {
    .contact-sheet {
      height: 86vh;
    }
    .contact-sheet__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-sheet {
      animation: none;
    }
    .contact-link {
      transition: none;
    }
  }
</style>
