---
/**
 * 主题切换按钮。
 *
 * - 使用原生 <button>，可用键盘操作。
 * - 有明确的无障碍名称，并随当前主题更新。
 * - 图标只是视觉提示，语义由 aria-label 承担。
 */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换浅色或深色主题">
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.4v2.2M12 19.4v2.2M4.4 12H2.2M21.8 12h-2.2M6.6 6.6 5.1 5.1M18.9 18.9l-1.5-1.5M17.4 6.6l1.5-1.5M5.1 18.9l1.5-1.5"></path>
  </svg>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z"></path>
  </svg>
</button>

<script>
  import { getCurrentTheme, toggleTheme } from '../scripts/theme';

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (button) {
    const labels = {
      light: '当前为浅色主题，切换到深色主题',
      dark: '当前为深色主题，切换到浅色主题',
    };

    const syncLabel = () => {
      button.setAttribute('aria-label', labels[getCurrentTheme()]);
      button.setAttribute('title', labels[getCurrentTheme()]);
    };

    syncLabel();

    button.addEventListener('click', () => {
      toggleTheme();
      syncLabel();
    });
  }
</script>
