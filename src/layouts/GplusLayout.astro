---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { site } from '../config/site';
import {
  GROUP_LABEL,
  groupOf,
  gplusName,
  gplusProfileUrl,
  gplusSourceUrl,
  isRosterHandle,
  type Gplus,
} from '../lib/gplus';

interface Props {
  post: Gplus;
  newer?: Gplus | null;
  older?: Gplus | null;
}

const { post, newer = null, older = null } = Astro.props;
const { title, description, pubDate, accounts, highlights, insights, interactions, people } = post.data;

const HTML_ESCAPES: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
};
const canonicalHandles = new Map<string, string>();
for (const handle of accounts) canonicalHandles.set(handle.toLowerCase(), handle);

function withMentions(text: string): string {
  const escaped = text.replace(/[&<>"']/g, (c) => HTML_ESCAPES[c] ?? c);
  return escaped.replace(/@([A-Za-z0-9_]+)/g, (whole, handle: string) => {
    const canonical = canonicalHandles.get(handle.toLowerCase());
    return canonical
      ? `<a class="daily-mention" href="${gplusProfileUrl(canonical)}" target="_blank" rel="noopener noreferrer">@${canonical}</a>`
      : whole;
  });
}

function sourceLinks(sources: string[]): string {
  const links = sources
    .map((key) => gplusSourceUrl(key))
    .filter((url): url is string => Boolean(url))
    .map((url, i) => `<a href="${url}" target="_blank" rel="noopener noreferrer">原文${sources.length > 1 ? i + 1 : ''} ↗</a>`);
  return links.length ? `<span class="gplus-sources">${links.join(' ')}</span>` : '';
}

/** 详细栏：按名单分组，创作者 / 品牌 / 信息号。只渲染确实有摘要的号。 */
const groups = ['creator', 'brand', 'info']
  .map((id) => ({
    id,
    label: GROUP_LABEL[id] ?? id,
    entries: people.filter((p) => p.summary.trim() && groupOf(p.handle) === id),
  }))
  .filter((g) => g.entries.length > 0);
const filtered = new Set(people.filter((p) => p.summary.trim()).map((p) => p.handle.toLowerCase()));
const extra = people.filter((p) => p.summary.trim() && !groups.some((g) => g.entries.includes(p)));
if (extra.length) {
  groups.push({ id: 'other', label: GROUP_LABEL.other, entries: extra });
}
for (const person of people) {
  if (!isRosterHandle(person.handle)) {
    console.warn(`[gplus] ${post.id} 的 @${person.handle} 不在名单 1-1 里，详细栏退回 handle`);
  }
}
---

<BaseLayout
  title={title}
  description={description || `${title} · ${post.id}`}
  ogType="article"
  feeds={[{ title: `${site.name} · Gplus`, href: '/gplus/rss.xml' }]}
>
  <ReadingProgress />
  <article class="page article-page">
    <div class="container article-page__inner">
      <div class="article-page__main">
        <a class="back-link" href="/gplus/"><span aria-hidden="true">←</span> 返回 Gplus</a>
        <header class="article-header">
          <h1 class="article-title">{title}</h1>
          <div class="article-meta">
            <span>发布于 <time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0, 16).replace('T', ' ')} UTC</time></span>
            <span><a href={`/gplus/${post.id}.txt`}>纯文本版</a></span>
          </div>
          {description ? <p class="article-description">{description}</p> : null}
          <p class="article-badge article-badge--page">AI 整理</p>
        </header>

        <div class="prose">
          <section class="daily-block">
            <h2>今日看点</h2>
            {highlights.length > 0 ? (
              highlights.map((claim) => (
                <p>
                  <span set:html={withMentions(claim.text)} />
                  <span class="gplus-sources" set:html={sourceLinks(claim.sources)} />
                </p>
              ))
            ) : <p class="daily-pending">今日看点待补充。</p>}
          </section>

          {interactions.length > 0 ? (
            <section class="daily-block">
              <h2>账号互动</h2>
              <ul>
                {interactions.map((claim) => (
                  <li>
                    <span set:html={withMentions(claim.text)} />
                    <span class="gplus-sources" set:html={sourceLinks(claim.sources)} />
                  </li>
                ))}
              </ul>
            </section>
          ) : null}

          {people.length > 0 ? (
            <section class="daily-block">
              <h2>详细</h2>
              {groups.map((group) => (
                <div class="gplus-group">
                  <h3 class="gplus-group__label">{group.label}</h3>
                  <ul class="daily-roster" id={`gplus-list-${group.id}`}>
                    {group.entries.map((person) => (
                      <li>
                        <a class="daily-roster__name" href={gplusProfileUrl(person.handle)} target="_blank" rel="noopener noreferrer">
                          {gplusName(person.handle)}
                        </a>
                        <span class="daily-roster__sep">：</span>
                        <span set:html={withMentions(person.summary)} />
                        <span class="gplus-sources" set:html={sourceLinks(person.sources)} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ) : null}

          {insights.length > 0 ? (
            <section class="daily-block">
              <h2>洞察</h2>
              <ul>
                {insights.map((claim) => (
                  <li>
                    <span set:html={withMentions(claim.text)} />
                    <span class="gplus-sources" set:html={sourceLinks(claim.sources)} />
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
        </div>

        {newer || older ? (
          <nav class="article-nav" aria-label="Gplus 导航">
            {newer ? (
              <a class="article-nav__item" href={`/gplus/${newer.id}/`}>
                <span class="article-nav__label">较新一篇</span><span class="article-nav__title">{newer.data.title}</span>
              </a>
            ) : <span></span>}
            {older ? (
              <a class="article-nav__item article-nav__item--next" href={`/gplus/${older.id}/`}>
                <span class="article-nav__label">较旧一篇</span><span class="article-nav__title">{older.data.title}</span>
              </a>
            ) : null}
          </nav>
        ) : null}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .gplus-sources {
    display: inline-flex;
    gap: 0.5em;
    margin-left: 0.6em;
    font-size: 0.85em;
    opacity: 0.75;
  }
  .gplus-group { margin-bottom: 1.6em; }
  .gplus-group__label { font-size: 1.05em; margin: 0 0 0.5em; }
</style>
