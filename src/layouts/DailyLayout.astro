---
import BaseLayout from './BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import ReadingProgress from '../components/ReadingProgress.astro';
import { site } from '../config/site';
import { formatIssueTime, type Daily, type DailyJa } from '../lib/daily';
import {
  BILIBILI_CATEGORY,
  BILIBILI_LABEL,
  loadBilibiliGroups,
} from '../lib/bilibili-daily';
import {
  categoryLabelOf,
  categoryOf,
  categoryRankOf,
  displayNameOf,
  nameOf,
  profileUrlOf,
} from '../lib/roster';

interface Props {
  post: Daily;
  /** 较新的一篇（发布日期更晚），可为空 */
  newer?: Daily | null;
  /** 较旧的一篇，可为空 */
  older?: Daily | null;
  /** 日语版（`data/daily/<期号>/report.ja.json`）。没有就不挂「日本語版」按钮。 */
  ja?: DailyJa | null;
}

const { post, newer = null, older = null, ja = null } = Astro.props;

/**
 * 整期长图。`daily publish` 顺手出图，落在 `public/images/daily/<期号>.webp`；
 * 老期号没有这个文件，就不渲染——不报错、不留空框。
 *
 * 宽高交给 sharp 读（WebP 有 VP8/VP8L/VP8X 三种头，自己拆容易踩坑），
 * 省得页面写死一个比例：长图高度随条目数变，写死会在加载时抖一下。
 */
const dailyImage = await (async () => {
  // 用 cwd 而不是 import.meta.url：构建时组件的 url 指向虚拟模块，拼不出 public 的路径
  const file = path.join(process.cwd(), 'public', 'images', 'daily', `${post.id}.webp`);
  if (!fs.existsSync(file)) return null;
  const meta = await sharp(file).metadata();
  if (!meta.width || !meta.height) return null;
  return {
    src: `/images/daily/${post.id}.webp`,
    width: meta.width,
    height: meta.height,
  };
})();
const {
  title,
  description,
  pubDate,
  accounts,
  highlights,
  insights,
  interactions,
  works,
  people,
  categories,
} = post.data;

/**
 * 名单只渲染「当日确实有活动」的人：summary 为空即视为没有值得写的一句话。
 * 这样生成端可以放心把抓到的账号全列进来，不必自己判断谁该出现。
 *
 * 名字来自名单（`src/config/daily-roster.json`），不写进数据——
 * 同一个人有主号/小号/告知号，名字只有一处能改，才不会出现「同一人两个写法」。
 * 名单里没有的 handle 退回显示 @handle，并在这里告警：那说明名单漏了人。
 */
const roster = people.filter((p) => p.summary.trim().length > 0);
for (const person of roster) {
  if (!displayNameOf(person.handle)) {
    console.warn(`[daily] ${post.id} 的 @${person.handle} 不在名单里，详细栏会显示 handle`);
  }
}

/**
 * 正文里的 `@handle` 自动变成主页链接，但只认这一期出现过的号。
 * 先转义再加链接——顺序反了会把文字里的 `<` 当成标签。
 */
const canonicalHandle = new Map<string, string>();
for (const handle of [...accounts, ...people.flatMap((p) => [p.handle, ...p.via])]) {
  canonicalHandle.set(handle.toLowerCase(), handle);
}

const HTML_ESCAPES: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;',
};

function withMentions(text: string): string {
  const escaped = text.replace(/[&<>"']/g, (char) => HTML_ESCAPES[char] ?? char);
  return escaped.replace(/@([A-Za-z0-9_]+)/g, (whole, handle: string) => {
    const canonical = canonicalHandle.get(handle.toLowerCase());
    if (!canonical) return whole;
    return `<a class="daily-mention" href="${profileUrlOf(canonical)}" target="_blank" rel="noopener noreferrer">@${canonical}</a>`;
  });
}

/**
 * 名单里带 `profile_url` 的非 X 账号（`source=bilibili` 的 B 站动态监控号）
 * 链到 B 站空间；其余仍是 X 主页。旧期号里没有这些字段，行为不变。
 */
const profileUrl = profileUrlOf;

/**
 * B 站动态（2026-11-12 用户裁决）。
 *
 * B 站监控号抓到的**全部**动态都要在 Galgame 日报里呈现，但日报正本
 * `report.json` 是受保护的 LLM 产物，不能往里塞原始条目——所以这里直接读
 * `data/bilibili/galgame/<覆盖日 JST>.jsonl`，只在「详细」段渲染，不进
 * .txt / .json / Ci-en 任何一个出口。
 *
 * 文件名就是 JST 自然日，而 `covered` 是期号覆盖那一天的 JST 零点，两者一一对应：
 * 抓到哪天就归哪一期，不用再猜窗口。当天没抓到（老期号、断抓）就是空数组，
 * 按钮也不会出现——和「空栏目不摆按钮」的旧约定一致。
 *
 * 声优版不渲染：B 站名单是 Galgame 版的补充源。
 *
 * 2026-11-12 追加口径：同一个账号的归到一起，合并后超过 150 字就概括。
 * 归并与概括都在取数层算好（`groupBilibiliRows`），页面只负责排版——
 * 一条动态一个 `-` 的清单会被「一天发十几条的官号」挤爆，读起来也找不到重点。
 */
const bilibiliGroups = post.data.kind === 'galgame' ? loadBilibiliGroups(post.data.covered) : [];

/** 一行 B 站动态的注脚：`共 6 条 · 概括` / `共 6 条` / `概括` / 空。 */
function bilibiliNote(group: { count: number; summarized: boolean }): string {
  return [
    group.count > 1 ? `共 ${group.count} 条` : '',
    group.summarized ? '概括' : '',
  ].filter(Boolean).join(' · ');
}

/**
 * 按栏目（声优版：声优 / 音声社团；Galgame 版：游戏制造商 / 信息号 / B站动态）分组，
 * 给「详细」栏的筛选按钮用。
 *
 * 顺序跟名单的 `categories` 走，不跟数据走：同一期里「声优在前、社团在后」
 * 应该是稳定约定，而不是「谁先被抓到谁排前面」。B 站名单排在两份 X 名单之后，
 * 所以「B站动态」天然是 Galgame 版的第三个按钮。
 *
 * 只保留这一期确实有条目的栏目——空栏目的按钮点开是空的，等于骗人。
 */
const categoriesPresent = (() => {
  const counts = new Map<string, number>();
  for (const person of roster) {
    const id = categoryOf(person.handle);
    counts.set(id, (counts.get(id) ?? 0) + 1);
  }
  if (bilibiliGroups.length > 0) counts.set(BILIBILI_CATEGORY, bilibiliGroups.length);
  return [...counts.entries()]
    .map(([id, count]) => ({
      id,
      // 名单里的标签是「B站Gal」（给周报分类用），日报里读者看到的是「B站动态」
      label: id === BILIBILI_CATEGORY ? BILIBILI_LABEL : categoryLabelOf(id),
      count,
      rank: categoryRankOf(id),
    }))
    .sort((a, b) => a.rank - b.rank || b.count - a.count);
})();

/**
 * 默认栏目按**版**走：声优版默认声优，Galgame 版默认游戏制造商。
 * 某期那一栏没有条目（或名单漏了人）就退回第一个栏目。
 */
const preferredCategory = post.data.kind === 'galgame' ? 'manufacturer' : 'seiyuu';
const defaultCategory = categoriesPresent.some((item) => item.id === preferredCategory)
  ? preferredCategory
  : (categoriesPresent[0]?.id ?? '');

/** 只有一个栏目时按钮点不出任何变化，整排不渲染。 */
const showCategoryFilter = categoriesPresent.length > 1;

/** 多栏目同时显示时按栏目聚在一起，扫起来才知道「下面是另一批人」。 */
const sortedRoster = showCategoryFilter
  ? [...roster].sort(
      (a, b) => categoryRankOf(categoryOf(a.handle)) - categoryRankOf(categoryOf(b.handle))
    )
  : roster;

// 忘了跑 LLM 那一步时别静默少一段——构建日志里要看得见
if (highlights.length === 0) {
  console.warn(`[daily] ${post.id} 的 highlights 为空，页面会显示「待补充」`);
}
if (roster.length === 0) {
  console.warn(`[daily] ${post.id} 的 people 全为空摘要，「详细」一段不会渲染`);
}
if (!description) {
  console.warn(`[daily] ${post.id} 缺 description，副标题会退回标题拼接`);
} else if (/^\d{4}-\d{2}-\d{2}|摘要（@/.test(description)) {
  // 副标题要写「今日看点」的简报，不是日期 + 账号名——后者在标题和「详细」里已经有了
  console.warn(`[daily] ${post.id} 的 description 仍是「日期 + 账号名」旧写法，应改成 ≤70 字看点简报`);
} else if (/声优侧|厂商侧|社团侧/.test(description)) {
  // 「侧」是内部的栏目叫法，读者看不到那条边界。优先写具体的人或公司；
  // 真要写整体（例如全行业同日冲发售日）就直接说「厂商」「声优」。
  console.warn(`[daily] ${post.id} 的 description 用了「XX侧」，改成具体的人或公司，写整体就直接说「厂商」「声优」`);
}

/**
 * 日语版的被覆率。**允许只翻一部分**（翻译是人工的一步），但缺人必须看得见：
 * 少了人不会让构建失败，读者却会以为那天这个人没动静。
 */
if (ja) {
  const translated = new Set(ja.data.people.map((person) => person.handle));
  const missing = roster.filter((person) => !translated.has(person.handle));
  if (missing.length > 0) {
    console.warn(
      `[daily] ${post.id} 的日语版缺 ${missing.length} 人：${missing
        .slice(0, 6)
        .map((person) => `@${person.handle}`)
        .join('、')}${missing.length > 6 ? ' 等' : ''}`
    );
  }

  const known = new Set(roster.map((person) => person.handle));
  const extra = ja.data.people.filter((person) => !known.has(person.handle));
  if (extra.length > 0) {
    console.warn(
      `[daily] ${post.id} 的日语版有 ${extra.length} 个 handle 不在本期「详细」里：${extra
        .slice(0, 6)
        .map((person) => person.handle)
        .join('、')}（多半是写错了，这些行不会输出）`
    );
  }
}
---

<BaseLayout
  title={title}
  description={description || `${title} · ${post.id}`}
  ogType="article"
  feeds={[{ title: `${site.name} · 日报`, href: '/daily/rss.xml' }]}
>
  <ReadingProgress />

  <article class="page article-page">
    <div class="container article-page__inner">
      <div class="article-page__main">
        <a class="back-link" href="/daily/">
          <span aria-hidden="true">←</span> 返回日报
        </a>

        <header class="article-header">
          <h1 class="article-title">{title}</h1>
          <div class="article-meta">
            {/*
              「覆盖哪一天」已经在标题里（`X 日报 · 2026-10-27`），不再单独写一行
              「覆盖 … 00:00–24:00（日本时间）」——同一件事说两遍，读者还要自己
              对一遍日期。这里只留真实发布时刻，来自 `issue.published_at`。
            */}
            <span>
              发布于
              <time datetime={pubDate.toISOString()}>{formatIssueTime(pubDate)}</time>
            </span>
            {/*
              纯文本出口。给读者「复制整期」用，也给 M6 的口播稿当输入。
              JSON 出口不在这里链——那是给程序和脚本的，放出来只会让人点开一堆花括号。
              Ci-en 出口是**另一个出口**而不是同一份文本的翻译开关：它是中日双语的，
              而且按 Ci-en 的记法排过版（见 `lib/cien.ts`），只收声优栏目。
              标签就写「Ci-en」，别写「日语版」——读者会以为是纯日文。
            */}
            <span>
              <a href={`/daily/${post.id}.txt`}>纯文本版</a>
            </span>
            {ja ? (
              <span>
                <a href={`/daily/${post.id}.ja.txt`}>Ci-en</a>
              </span>
            ) : null}
          </div>
          {description ? <p class="article-description">{description}</p> : null}
          {/*
            整栏都是 AI 整理，所以标记是无条件的——M4 之前靠 frontmatter 的 `source`
            判断，但那个字段每一期都是 `ai`，等于恒真。数据里删掉它，披露反而更明确：
            不存在「这期不是 AI 写的」这种状态。
          */}
          <p class="article-badge article-badge--page">AI 整理</p>
        </header>

        <div class="prose">
          <section class="daily-block">
            <h2>今日看点</h2>
            {
              highlights.length > 0 ? (
                highlights.map((claim) => <p set:html={withMentions(claim.text)} />)
              ) : (
                <p class="daily-pending">今日看点待补充。</p>
              )
            }
          </section>

          {
            categories.some((category) => category.summary.trim().length > 0) ? (
              <section class="daily-block">
                <h2>分类摘要</h2>
                <ul class="daily-roster">
                  {categories
                    .filter((category) => category.summary.trim().length > 0)
                    .map((category) => (
                      <li>
                        <span class="daily-roster__name">{category.label}</span>
                        <span class="daily-roster__sep">：</span>
                        <span set:html={withMentions(category.summary)} />
                      </li>
                    ))}
                </ul>
              </section>
            ) : null
          }

          {
            works.length > 0 ? (
              <section class="daily-block">
                <h2>作品动态</h2>
                <ul>
                  {works.map((line) => (
                    <li set:html={withMentions(line)} />
                  ))}
                </ul>
              </section>
            ) : null
          }

          {/*
            长图插在「作品动态」之后：那是读者扫完标题、要点、作品后，
            最想「存一张走」的位置。图本身就是整期的浓缩版（题目 / 要点 / 作品）。
          */}
          {
            dailyImage ? (
              <figure class="daily-figure">
                <img
                  src={dailyImage.src}
                  width={dailyImage.width}
                  height={dailyImage.height}
                  alt={`${title} 长图`}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            ) : null
          }

          {
            interactions.length > 0 ? (
              <section class="daily-block">
                <h2>互动</h2>
                <ul>
                  {interactions.map((claim) => (
                    <li set:html={withMentions(claim.text)} />
                  ))}
                </ul>
              </section>
            ) : null
          }

          {
            roster.length > 0 || bilibiliGroups.length > 0 ? (
              <section class="daily-block">
                <h2>详细</h2>
                {/*
                  栏目筛选：默认只亮一栏（声优版「声优」、Galgame 版「游戏制造商」）。
                  点另一个栏目是**加**（两个都亮），再点自己一次是**减**——所以
                  「只想看制造商」是「点制造商、再点声优」，不用先全清再选。
                  「B站动态」是第三个按钮，与游戏制造商 / 信息号平行；筛选脚本只看
                  `[data-category]`，新栏目不需要改任何客户端逻辑。
                  交互和笔记页的标签按钮一致（aria-pressed 表达选中）。
                */}
                {showCategoryFilter ? (
                  <div class="daily-filter" data-daily-filter role="group" aria-label="按栏目筛选">
                    <span class="daily-filter__label">栏目</span>
                    {categoriesPresent.map((item) => (
                      <button
                        class="daily-filter__tag"
                        type="button"
                        data-category-filter
                        data-category={item.id}
                        aria-pressed={item.id === defaultCategory ? 'true' : 'false'}
                        aria-controls="daily-detail-list"
                      >
                        {item.label}
                      </button>
                    ))}
                  </div>
                ) : null}
                <ul class="daily-roster" id="daily-detail-list" data-daily-roster>
                  {sortedRoster.map((person) => (
                    <li data-category={categoryOf(person.handle)}>
                      <a
                        class="daily-roster__name"
                        href={profileUrl(person.handle)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {nameOf(person.handle)}
                      </a>
                      <span class="daily-roster__sep">：</span>
                      <span set:html={withMentions(person.summary)} />
                      {person.via.length > 0 ? (
                        <span class="daily-roster__via">
                          <span aria-hidden="true">·</span>
                          {person.via.map((via, index) => (
                            <>
                              {index > 0 ? <span aria-hidden="true">、</span> : null}
                              <a href={profileUrl(via)} target="_blank" rel="noopener noreferrer">
                                @{via}
                              </a>
                            </>
                          ))}
                        </span>
                      ) : null}
                    </li>
                  ))}
                  {/*
                    B 站动态：**一个账号一行**（同账号的归到一起），正文合计超过 150 字
                    时用取数层算好的概括。`data-category` 让上面那排按钮顺带管住这些行。
                    注脚写明「共 N 条 · 概括」，读者才知道这行不是原文全文；
                    原文链接一条不少，多条时按 1、2、3 编号列出（不丢任何一条的出处）。
                  */}
                  {bilibiliGroups.map((group) => (
                    <li data-category={BILIBILI_CATEGORY} class="daily-roster__bili">
                      <a
                        class="daily-roster__name"
                        href={profileUrl(group.handle)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {nameOf(group.handle)}
                      </a>
                      <span class="daily-roster__sep">：</span>
                      <span class="daily-roster__bili-text">{group.text}</span>
                      {bilibiliNote(group) ? (
                        <span class="daily-roster__bili-note">{bilibiliNote(group)}</span>
                      ) : null}
                      <span class="daily-roster__bili-links">
                        {group.urls.map((url, index) => (
                          <a
                            class="daily-roster__bili-link"
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {group.urls.length > 1 ? `原文${index + 1} ↗` : '原文 ↗'}
                          </a>
                        ))}
                      </span>
                    </li>
                  ))}
                </ul>
                {showCategoryFilter ? (
                  <p class="daily-pending" data-daily-filter-empty hidden>
                    未选择栏目。点上方按钮显示对应条目。
                  </p>
                ) : null}
              </section>
            ) : null
          }

          {
            insights.length > 0 ? (
              <section class="daily-block">
                <h2>洞察</h2>
                <ul>
                  {insights.map((claim) => (
                    <li set:html={withMentions(claim.text)} />
                  ))}
                </ul>
              </section>
            ) : null
          }
        </div>

        {
          newer || older ? (
            <nav class="article-nav" aria-label="日报导航">
              {newer ? (
                <a class="article-nav__item" href={`/daily/${newer.id}/`}>
                  <span class="article-nav__label">较新一篇</span>
                  <span class="article-nav__title">{newer.data.title}</span>
                </a>
              ) : (
                <span></span>
              )}
              {older ? (
                <a class="article-nav__item article-nav__item--next" href={`/daily/${older.id}/`}>
                  <span class="article-nav__label">较旧一篇</span>
                  <span class="article-nav__title">{older.data.title}</span>
                </a>
              ) : null}
            </nav>
          ) : null
        }
      </div>
    </div>
  </article>

  <script>
    import '../scripts/daily-filter.ts';
  </script>
</BaseLayout>
