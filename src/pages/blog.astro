---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, groupPostsByYear, formatDate, postPath } from '../lib/posts';

const posts = await getPublishedPosts();
const groups = groupPostsByYear(posts);

// 收集所有标签（去重、按 Unicode 排序），用于标签筛选栏。
// 没有任何标签时不渲染筛选栏，但搜索栏仍可用。
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b),
);
---

<BaseLayout title="笔记" description="文章与长期内容的索引，按年份分组，支持搜索、标签筛选与分页。">
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">笔记</h1>
      </header>

      {
        posts.length > 0 ? (
          <div class="archive-filter" data-archive-filter>
            <form class="archive-search" role="search" data-search-form>
              <label class="visually-hidden" for="archive-search-input">搜索文章</label>
              <input
                class="archive-search__input"
                id="archive-search-input"
                data-search-input
                type="search"
                name="q"
                autocomplete="off"
                placeholder="搜索标题、摘要或标签"
                aria-describedby="archive-result-count"
              />
              <button class="archive-search__button" type="submit">搜索</button>
              <button
                class="archive-search__button archive-search__button--ghost"
                type="button"
                data-search-clear
              >
                清空
              </button>
            </form>

            {
              allTags.length > 0 ? (
                <div class="archive-tags" role="group" aria-label="按标签筛选">
                  <span class="archive-tags__label">标签</span>
                  {allTags.map((tag) => (
                    <button
                      class="archive-tag"
                      type="button"
                      data-tag-filter
                      data-tag={tag}
                      aria-pressed="false"
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              ) : null
            }

            <div class="archive-filter__status">
              <p
                class="archive-filter__count"
                id="archive-result-count"
                data-result-count
                aria-live="polite"
              >
                共 {posts.length} 篇
              </p>
              <button class="archive-filter__clear" type="button" data-clear-all hidden>
                清除全部筛选
              </button>
            </div>

            <p class="empty-state archive-filter__empty" data-search-empty hidden>
              没有匹配的文章。试试更换关键词或清除筛选条件。
            </p>

            <nav class="archive-pagination" data-archive-pagination hidden aria-label="分页导航">
              <button class="archive-pagination__btn" type="button" data-page-prev aria-label="上一页">上一页</button>
              <div class="archive-pagination__numbers" data-page-numbers aria-label="页码"></div>
              <span class="archive-pagination__info" data-page-info aria-live="polite"></span>
              <button class="archive-pagination__btn" type="button" data-page-next aria-label="下一页">下一页</button>
            </nav>
          </div>
        ) : null
      }

      {
        groups.length > 0 ? (
          groups.map((group) => (
            <section class="archive-group" aria-labelledby={`year-${group.year}`}>
              <h2 class="archive-year" id={`year-${group.year}`}>
                {group.year}
              </h2>
              <ul class="article-list">
                {group.posts.map((post) => (
                  <li
                    class="article-list__item"
                    data-search-item
                    data-title={post.data.title}
                    data-description={post.data.description ?? ''}
                    data-tags={JSON.stringify(post.data.tags)}
                  >
                    <a class="article-list__link" href={postPath(post)}>
                      <span class="article-list__title">{post.data.title}</span>
                      <time class="article-list__meta" datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate)}
                      </time>
                      {post.data.description ? (
                        <span class="article-list__description">{post.data.description}</span>
                      ) : null}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        ) : (
          <p class="empty-state">暂无文章。笔记会随新文章发布自动更新。</p>
        )
      }
    </div>
  </div>

  <button class="back-to-top" type="button" data-back-to-top aria-label="返回顶部">
    <span aria-hidden="true">↑</span>
  </button>

  <script>
    import '../scripts/archive-filter.ts';
    import '../scripts/back-to-top.ts';
  </script>
</BaseLayout>
