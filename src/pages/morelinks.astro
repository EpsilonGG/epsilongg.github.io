---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkList from '../components/LinkList.astro';
import LinkCards from '../components/LinkCards.astro';
import IconGrid from '../components/IconGrid.astro';
import BadgeWall from '../components/BadgeWall.astro';
import { linkGroups } from '../config/links';

const visibleGroups = linkGroups.filter((group) => group.links.length > 0);
---

<BaseLayout title="链接库" description="整理外部平台、项目仓库、工具、研究资料与友情链接。">
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">链接库</h1>
        <p class="page-intro">整理经常访问或希望分享的外部资源。</p>
      </header>

      {
        visibleGroups.length > 0 ? (
          visibleGroups.map((group) => (
            <section class="link-group" aria-labelledby={`group-${group.id}`}>
              <h2 class="link-group__heading" id={`group-${group.id}`}>{group.title}</h2>
              {group.description ? <p class="link-group__description">{group.description}</p> : null}
              {group.layout === 'badges' ? (
                <BadgeWall links={group.links} />
              ) : group.layout === 'cards' ? (
                <LinkCards links={group.links} />
              ) : group.layout === 'icons' ? (
                <IconGrid links={group.links} />
              ) : (
                <LinkList links={group.links} />
              )}
            </section>
          ))
        ) : (
          <p class="empty-state">链接整理中，稍后补充。</p>
        )
      }
    </div>
  </div>
</BaseLayout>
