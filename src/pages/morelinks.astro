---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkRow from '../components/LinkRow.astro';
import { linkGroups } from '../config/links';

const visibleGroups = linkGroups.filter((group) => group.links.length > 0);
---

<BaseLayout title="链接库" description="整理外部平台、项目仓库、研究资料与工具链接。">
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">链接库</h1>
        <p class="page-intro">整理经常访问或希望分享的外部资源。内容在 <code>src/config/links.ts</code> 中维护。</p>
      </header>

      {
        visibleGroups.length > 0 ? (
          visibleGroups.map((group) => (
            <section class="link-group" aria-labelledby={`group-${group.id}`}>
              <h2 class="link-group__heading" id={`group-${group.id}`}>{group.title}</h2>
              {group.description ? <p class="link-group__description">{group.description}</p> : null}
              <ul class="link-list">
                {group.links.map((link) => (
                  <li>
                    <LinkRow label={link.label} href={link.href} description={link.description} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        ) : (
          <p class="empty-state">链接整理中，稍后补充。</p>
        )
      }
    </div>
  </div>
</BaseLayout>
