---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title="页面不存在" description="请求的页面不存在或已被移动。" noindex>
  <div class="page">
    <div class="container">
      <div class="not-found">
        <p class="not-found__code">404</p>
        <h1 class="not-found__title">页面不存在</h1>
        <p class="not-found__text">
          你访问的地址没有对应的页面，可能是链接输入有误，或者这个页面已经移动。
        </p>

        <div class="not-found__game">
          <canvas
            id="dino-game"
            width="800"
            height="300"
            role="img"
            aria-label="一个跳跃小游戏：按空格或点击开始，跳跃躲避障碍物，碰撞后按空格重新开始。"
          ></canvas>
          <p class="not-found__game-hint">
            空格 / 点击 开始 · 跳跃躲避障碍 · 再次空格重开
          </p>
        </div>

        <div class="not-found__links">
          <a href="/">返回首页</a>
          <a href="/archive/">前往笔记</a>
          {site.email ? <a href={`mailto:${site.email}`}>报告问题</a> : null}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/404-game.ts';
</script>
