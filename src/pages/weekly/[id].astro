---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import {
  getWeeklyReports,
  weeklyPath,
  weeklyJsonPath,
  formatWeeklyPublished,
  publishedDate,
  type WeeklyReport,
} from '../../lib/weekly';
import '../../styles/weekly.css';

/**
 * 周报详情页。正文不在这里拼：`report.content_html` 是发布层（`python -m weekly
 * publish`）生成好的片段，站点只负责套版式。这样「线上看到的字」与
 * `data/weekly/<期号>/report.json` 逐字一致，`check_weekly_publish.py` 才能验。
 *
 * 上下期由已发布期号排序派生（`getWeeklyReports` 已按期号倒序），
 * 不读正本里的 `issue.previous`——那个字段只是给外部消费者的提示。
 *
 * 版式与笔记详情页同构：左侧栏复用 ArticleSidebar（截断标题 + 栏目目录 +
 * 首页 / 置顶 / 较新 / 较旧），正文居中；窄屏整栏塌成单列。
 */
export function getStaticPaths() {
  const reports = getWeeklyReports();
  return reports.map((report, index) => ({
    params: { id: report.issue.id },
    props: {
      report,
      newer: reports[index - 1] ?? null,
      older: reports[index + 1] ?? null,
    },
  }));
}

const { report, newer, older } = Astro.props as {
  report: WeeklyReport;
  newer: WeeklyReport | null;
  older: WeeklyReport | null;
};

const { issue, toc } = report;
---

<BaseLayout title={issue.title} description={report.description} ogType="article">
  <ReadingProgress />

  <article class="page article-page">
    <div class="container article-page__inner">
      <ArticleSidebar
        title={issue.title}
        headings={toc.map((item) => ({ depth: 2, slug: item.id, text: item.label }))}
        newer={newer ? { href: weeklyPath(newer.issue.id), title: newer.issue.title } : null}
        older={older ? { href: weeklyPath(older.issue.id), title: older.issue.title } : null}
      />

      <div class="article-page__main">
        <a class="back-link" href="/weekly/">
          <span aria-hidden="true">←</span> 返回周报
        </a>

        <header class="article-header">
          <p class="weekly-header__id">周报 · {issue.window_label}</p>
          <h1 class="article-title">{issue.id}</h1>
          <div class="article-meta">
            <span>
              发布
              <time datetime={publishedDate(report).toISOString()}>
                {formatWeeklyPublished(publishedDate(report))}
              </time>
            </span>
            <span>
              <a href={weeklyJsonPath(issue.id)}>JSON</a>
            </span>
          </div>
        </header>

        <p class="weekly-highlight">{report.highlight}</p>

        <div class="weekly-body" set:html={report.content_html} />

        {
          newer || older ? (
            <nav class="article-nav" aria-label="周报导航">
              {older ? (
                <a class="article-nav__item" href={weeklyPath(older.issue.id)}>
                  <span class="article-nav__label">较旧一期</span>
                  <span class="article-nav__title">{older.issue.title}</span>
                </a>
              ) : (
                <span></span>
              )}
              {newer ? (
                <a class="article-nav__item article-nav__item--next" href={weeklyPath(newer.issue.id)}>
                  <span class="article-nav__label">较新一期</span>
                  <span class="article-nav__title">{newer.issue.title}</span>
                </a>
              ) : null}
            </nav>
          ) : null
        }
      </div>
    </div>
  </article>
</BaseLayout>
