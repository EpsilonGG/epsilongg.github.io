---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { getWeeklyReports, weeklyPath } from '../../lib/weekly';
import '../../styles/weekly.css';

/**
 * 周报归档页。与 `/daily/` 平行的一级栏目。
 *
 * 一行三期信息：期号 / 窗口短标签 / 本期亮点。发布日期与条数不再上列表——
 * 期号说明「第几期」，短标签说明「覆盖哪七天」，亮点说明「这期讲了什么」，
 * 三者够读；要细节点进去就有。
 */
const reports = getWeeklyReports();
---

<BaseLayout
  title="周报"
  description="Galgame 周报存档：把每天的 Galgame 日报汇总成一期，按新作与作品情报整理"
  feeds={[{ title: `${site.name} · 周报`, href: '/weekly/rss.xml' }]}
>
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">周报</h1>
        <p class="page-intro">
          把每天的 Galgame 日报汇总成一期：新作与作品情报两栏，按品牌、游戏归拢。
          每周六更新，期号是 <code>vol_XXX</code>。
        </p>
      </header>

      {
        reports.length > 0 ? (
          <div class="weekly-archive">
            <ul class="weekly-archive__list">
              {reports.map((report) => (
                <li class="weekly-archive__item">
                  <a class="weekly-archive__link" href={weeklyPath(report.issue.id)}>
                    <span class="weekly-archive__id">{report.issue.id}</span>
                    <span class="weekly-archive__title">{report.issue.window_label}</span>
                    <span class="weekly-archive__desc">{report.highlight}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="empty-state">
            还没有周报。每周六由 <code>python -m weekly publish</code> 出一期，正本落在{' '}
            <code>data/weekly/&lt;期号&gt;/report.json</code>。
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
