---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import {
  getDailyReports,
  groupByMonth,
  dailyPath,
  formatIssueDay,
  type Daily,
} from '../../lib/daily';

const reports = await getDailyReports();
const months = groupByMonth(reports);

/**
 * 归档列表里省掉年份：分组标题已经写了月份，行里只要 `10-27`。
 * 一天出两期时标出「第 2 期」——期号里的 `-2` 不该让读者自己去解码。
 */
function shortDay(report: Daily): string {
  const day = formatIssueDay(report.data.covered).slice(5);
  return report.data.seq > 1 ? `${day} · 第 ${report.data.seq} 期` : day;
}
---

<BaseLayout
  title="日报"
  description="X（推特）声优动态日报存档，按日期编号"
  feeds={[{ title: `${site.name} · 日报`, href: '/daily/rss.xml' }]}
>
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">日报</h1>
        {
          months.length > 1 ? (
            <p class="daily-archive__jump">
              <span class="daily-archive__jump-label">跳到</span>
              {months.map((month) => (
                <a class="daily-archive__chip" href={`#${month.key}`}>
                  {month.label}
                </a>
              ))}
            </p>
          ) : null
        }
      </header>

      {
        months.length > 0 ? (
          <div class="daily-archive">
            {months.map((month) => (
              <section class="daily-archive__month" id={month.key}>
                <h2 class="daily-archive__month-title">
                  {month.label}
                  <span class="daily-archive__count">{month.items.length} 期</span>
                </h2>
                <ul class="daily-archive__list">
                  {month.items.map((report) => (
                    <li class="daily-archive__item">
                      <a class="daily-archive__link" href={dailyPath(report)}>
                        <time
                          class="daily-archive__time"
                          datetime={formatIssueDay(report.data.covered)}
                        >
                          {shortDay(report)}
                        </time>
                        <span class="daily-archive__summary">
                          {report.data.description ?? '（本期还没有写看点简报）'}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty-state">
            暂无日报。日报每天一期，每期一个目录（YYMMDD，同一天第二期是 YYMMDD-2），
            发布时由 <code>daily publish</code> 放进 data/daily/。
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
