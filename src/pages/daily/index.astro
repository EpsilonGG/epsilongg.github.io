---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import {
  getDailyReports,
  groupByMonth,
  dailyPath,
  formatIssueDay,
  formatIssueTime,
} from '../../lib/daily';

const reports = await getDailyReports();
const months = groupByMonth(reports);

const latest = reports[0] ?? null;
const earliest = reports[reports.length - 1] ?? null;

/** 归档列表里省掉年份：分组标题已经写了月份，行里只要 `10-23 22:00`。 */
function shortTime(date: Date): string {
  return `${formatIssueDay(date).slice(5)} ${formatIssueTime(date).slice(-5)}`;
}

// 用模板字符串拼成一句，避免 JSX 换行在中文里塞进多余空格
const note =
  latest === null
    ? ''
    : `共 ${reports.length} 期，最新 ${formatIssueTime(latest.data.pubDate)}` +
      (reports.length > 1 ? `，最早 ${formatIssueTime(earliest!.data.pubDate)}` : '') +
      '（均为日本时间）。每期按小时编号，同一天可以有多期，旧的一期不会被覆盖。';
---

<BaseLayout
  title="日报"
  description="X（推特）声优动态日报存档，按小时编号，由本地 WorkBuddy 整理"
  feeds={[{ title: `${site.name} · 日报`, href: '/daily/rss.xml' }]}
>
  <div class="page">
    <div class="container">
      <header class="page-header">
        <h1 class="page-title">日报</h1>
        {
          note ? (
            <p class="page-note">{note}</p>
          ) : null
        }
        {
          latest ? (
            <p class="daily-archive__jump">
              <a class="daily-archive__chip" href={dailyPath(latest)}>
                看最新一期（{formatIssueTime(latest.data.pubDate)}）
              </a>
              {months.length > 1 ? (
                <>
                  <span class="daily-archive__jump-label">跳到</span>
                  {months.map((month) => (
                    <a class="daily-archive__chip" href={`#${month.key}`}>
                      {month.label}
                    </a>
                  ))}
                </>
              ) : null}
            </p>
          ) : null
        }
      </header>

      {
        months.length > 0 ? (
          <div class="daily-archive">
            {months.map((month) => (
              <section class="daily-archive__month" id={month.key}>
                <h2 class="daily-archive__month-title">
                  {month.label}
                  <span class="daily-archive__count">{month.items.length} 期</span>
                </h2>
                <ul class="daily-archive__list">
                  {month.items.map((report) => (
                    <li class="daily-archive__item">
                      <a class="daily-archive__link" href={dailyPath(report)}>
                        <time
                          class="daily-archive__time"
                          datetime={report.data.pubDate.toISOString()}
                        >
                          {shortTime(report.data.pubDate)}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        ) : (
          <p class="empty-state">
            暂无日报。日报由本地 WorkBuddy 基于 X-Reader 抓取的推文生成，每期一个目录
            （YYMMDDHH），发布时由 <code>daily publish</code> 放进 data/daily/。
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>
