---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSidebar from '../../components/ArticleSidebar.astro';
import { site } from '../../config/site';
import {
  getDailyReports,
  groupByMonth,
  dailyPath,
  formatIssueDay,
  KIND_LABEL,
  type Daily,
} from '../../lib/daily';

const reports = await getDailyReports();
const months = groupByMonth(reports);

/**
 * 归档列表里省掉年份：分组标题已经写了月份，行里只要 `10-29 声优`。
 * 一天出两份，所以类型必须写出来——期号里的 `-g` 不该让读者自己去解码。
 * 同一天同一版的第二期再补一句「第 2 期」。
 */
function shortDay(report: Daily): string {
  const day = formatIssueDay(report.data.covered).slice(5);
  const label = `${day} ${KIND_LABEL[report.data.kind]}`;
  return report.data.seq > 1 ? `${label} · 第 ${report.data.seq} 期` : label;
}
---

<BaseLayout
  title="日报"
  description="X（推特）动态日报存档：每天两期，声优版与 Galgame 版"
  feeds={[{ title: `${site.name} · 日报`, href: '/daily/rss.xml' }]}
>
  <article class="page article-page">
    <div class="container article-page__inner">
      <ArticleSidebar
        title="日报"
        tocLabel="日期跳转"
        headings={months.map((month) => ({ depth: 2, slug: month.key, text: month.label }))}
      />

      <div class="article-page__main">
        <header class="page-header">
          <h1 class="page-title">日报</h1>
        </header>

        {
          months.length > 0 ? (
            <>
              <div class="archive-filter" data-archive-filter data-local-search>
                <form class="archive-search" role="search" data-search-form>
                  <label class="visually-hidden" for="daily-search-input">搜索日报</label>
                  <input
                    class="archive-search__input"
                    id="daily-search-input"
                    data-search-input
                    type="search"
                    name="q"
                    autocomplete="off"
                    placeholder="搜索日期、看点简报"
                    aria-describedby="daily-result-count"
                  />
                  <button class="archive-search__button" type="submit">搜索</button>
                  <button
                    class="archive-search__button archive-search__button--ghost"
                    type="button"
                    data-search-clear
                  >
                    清空
                  </button>
                </form>

                <div class="archive-filter__status">
                  <p
                    class="archive-filter__count"
                    id="daily-result-count"
                    data-result-count
                    data-count-unit="期"
                    aria-live="polite"
                  >
                    共 {reports.length} 期
                  </p>
                  <button class="archive-filter__clear" type="button" data-clear-all hidden>
                    清除全部筛选
                  </button>
                </div>

                <p class="empty-state archive-filter__empty" data-search-empty hidden>
                  没有匹配的日报。试试更换关键词或清除筛选条件。
                </p>

                <nav class="archive-pagination" data-archive-pagination hidden aria-label="分页导航">
                  <button class="archive-pagination__btn" type="button" data-page-prev aria-label="上一页">上一页</button>
                  <div class="archive-pagination__numbers" data-page-numbers aria-label="页码"></div>
                  <span class="archive-pagination__info" data-page-info aria-live="polite"></span>
                  <button class="archive-pagination__btn" type="button" data-page-next aria-label="下一页">下一页</button>
                </nav>
              </div>

              <div class="daily-archive">
                {months.map((month) => (
                  <section class="daily-archive__month archive-group" id={month.key}>
                    <h2 class="daily-archive__month-title">
                      {month.label}
                      <span class="daily-archive__count">{month.items.length} 期</span>
                    </h2>
                    <ul class="daily-archive__list">
                      {month.items.map((report) => (
                        <li
                          class="daily-archive__item"
                          data-search-item
                          data-title={`${formatIssueDay(report.data.covered)} ${KIND_LABEL[report.data.kind]}`}
                          data-description={report.data.description ?? ''}
                        >
                          <a class="daily-archive__link" href={dailyPath(report)}>
                            <time
                              class="daily-archive__time"
                              datetime={formatIssueDay(report.data.covered)}
                            >
                              {shortDay(report)}
                            </time>
                            <span class="daily-archive__summary">
                              {report.data.description ?? '（本期还没有写看点简报）'}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </>
          ) : (
            <p class="empty-state">
              暂无日报。每天两期，每期一个目录（声优版 YYMMDD，Galgame 版 YYMMDD-g；
              同一版第二期是 YYMMDD-2 / YYMMDD-g2），发布时由 <code>daily publish</code>
              放进 data/daily/。
            </p>
          )
        }
      </div>
    </div>
  </article>

  <script>
    import '../../scripts/archive-filter.ts';
  </script>
</BaseLayout>
