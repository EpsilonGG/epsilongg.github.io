---
import GplusLayout from '../../layouts/GplusLayout.astro';
import { getGplusReports } from '../../lib/gplus';

export async function getStaticPaths() {
  const reports = await getGplusReports();
  return reports.map((report, index) => ({
    params: { id: report.id },
    props: {
      post: report,
      newer: reports[index - 1] ?? null,
      older: reports[index + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
---

<GplusLayout post={post} newer={newer} older={older} />
