{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epsilongg.github.io/schemas/report.schema.json",
  "title": "Report",
  "description": "一份日报的正本。people 是扁平的，分类视图靠 filter 得到。claim = {text, sources}。",
  "type": "object",
  "required": ["schema_version", "issue", "counts", "description", "highlights", "interactions", "people", "provenance"],
  "properties": {
    "schema_version": { "type": "integer" },
    "issue": {
      "type": "object",
      "required": ["id", "published_at", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{6}(?:-(?:g(?:[2-9]|[1-9][0-9])?|(?:[2-9]|[1-9][0-9])))?$",
   "description": "YYMMDD（JST，声优版）/ YYMMDD-g（Galgame 版）；同日第二期 YYMMDD-2 / YYMMDD-g2。不带后缀 = 声优版" },
        "published_at": { "type": "string" },
        "window": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["draft", "confirmed"] },
        "confirmed_at": { "type": ["string", "null"] }
      }
    },
    "counts": {
      "type": "object",
      "required": ["items", "accounts"],
      "properties": {
        "items": { "type": "integer" },
        "accounts": { "type": "integer" },
        "late": { "type": "integer" },
        "skipped_duplicate": { "type": "integer" }
      }
    },
    "description": { "type": "string", "maxLength": 70 },
    "works": {
      "type": "string",
      "description": "作品动态：一段跨人汇总（制作中 / 发售 / 销量里程碑），不带来源链接——人名在 people 里已经链到主号"
    },
    "accounts": {
      "type": "array",
      "description": "当天有活动的账号（含只出现在 highlights 里、没有 people 行的人）。正文里的 @提及 靠它变成链接",
      "items": { "type": "string" }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "sources"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "sources"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "sources"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "sources"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "sources": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "interactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "sources"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "sources": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle"],
        "properties": {
          "handle": { "type": "string" },
          "category": { "type": "string" },
          "summary": { "type": "string" },
          "via": {
            "type": "array",
            "description": "同一个人的其他号（小号 / 社团号）。页面在句末渲染成小一号的账号名链接",
            "items": { "type": "string" }
          },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generator"],
      "properties": {
        "generator": { "type": "string" },
        "prompt_version": { "type": "integer" },
        "cache_key": { "type": "string" },
        "generated_at": { "type": "string" }
      }
    }
  }
}
