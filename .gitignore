# 依赖与构建产物
node_modules/
dist/
.astro/

# 文章图片的 WebP 变体是派生产物：由 scripts/optimize_images.mjs 在 dev/build 前生成
# （src/data/image-manifest.json 记录了尺寸与清单，那个要提交）
public/images/blog/**/*.webp

# 环境变量与密钥（永远不要提交）
.env
.env.*
!.env.example

# 本地系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python 测试缓存
__pycache__/
*.py[cod]
.venv/

# 日志
*.log
npm-debug.log*

# 本地工具产生的项目数据（不发布到公开仓库）
.workbuddy-ai/

# 日报本地组装产物（briefing 等中间文件，由 scripts/daily_digest.py 生成）
out/

# 日报的增量账本（记录哪些条目已经用过），属于本机状态，不进仓库
data/daily/state.json

# 本地查询缓存（VNDB 等），随时可删、随时重建
.cache/

# 出图草稿：pic/ 是 174 个模板跑出来的样张 + 日报长图各轮稿（约 84 MB），
# 只用来挑样式，正式产物在 public/images/daily/。别进仓库。
pic/

# 上游模板库 juya-news-card-main 的整份 checkout（自带 Next.js 应用，约 37 MB）。
# 我们只抄它的视觉语言，成品是 scripts/daily-image/render.mjs，不参与构建。
juya-news-card-main/

# 前期 B 站调研用的四份第三方 checkout（22 MB）。可复用的三件事已经用标准库
# 重写进 scripts/bilibili_daily.py；2026-11-11 清理掉，留个忽略项防止误提交。
weekcn/

# 周报本地工作台产物（corpus / filter / 预览 HTML / 图片缓存，约 13 MB）。
# 发布正本在 data/weekly/<vol_XXX>/，那个要提交；这个目录只是中间态。
weekly/out/

# 本机工具与模型权重（tools/audio-translate 约 7.8 GB），永远不进仓库
tools/

# 抓取侧 X-Reader 的 checkout（`git clone --depth 1` 到这儿，约 14 MB 数据）。
# 2026-11-01 从 Desktop/X-rss-workspace 搬进来：那个位置两天里被清掉两次，
# 每次都要重克隆。放在仓库目录内是唯一稳定的位置。用 daily_prepare.py 自动识别。
.xreader/
