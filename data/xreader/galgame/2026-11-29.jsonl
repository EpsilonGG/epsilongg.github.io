{"identity_key": "x:2126696365472551089", "source_id": "x", "item_id": "2126696365472551089", "title": null, "content": "13年前の本日は 妹のおかげでモテすぎてヤバい。(Hulotte) の発売日でした\n\n\n\nHulotte名物ヤバいシリーズ第1弾\n\n\n\n目的のキャラ以外を振り続けるコンセプトの作品\n\nキャラも可愛らしくシナリオも秀逸でしたが振る所までの盛り上げ方や振った振られた側の感情の機微等があっさりしていたのが少し残念でしたね", "publisher": "youtan0309", "canonical_url": "https://x.com/youtan0309/status/2126696365472551089", "published_at": "2026-11-28T15:15:00+00:00", "published_at_raw": "Sat, 28 Nov 2026 15:15:00 GMT", "published_precision": "second", "fetched_at": "2026-11-28T16:20:13.824789+00:00", "media": [], "metadata": {"account": "youtan0309", "author_name": "youtan0309", "is_retweet": false, "retweeted_by": null, "is_reply": false, "reply_to": null, "is_quote": false, "quoted_tweet_id": null, "quoted_author": null, "quoted_text": null, "is_pinned": false, "stats": {"replies": null, "retweets": null, "likes": null, "views": null}, "provider": "nitter", "route": "rss"}}
