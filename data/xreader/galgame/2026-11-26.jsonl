{"identity_key": "x:2125609202596925830", "source_id": "x", "item_id": "2125609202596925830", "title": null, "content": "16年前の本日は 失われた未来を求めて (TRUMPLE) の発売日でした\n\n\n\nTRUMPLE(前ABHAR)デビュー作\n\n\n\n水平線まで何マイル?の世界観を引き継ぎ内浜学園を舞台にしたSFタイムリープ作\n\n物語自体はメーカーの紆余曲折もありかなり雑な面もありましたが深崎暮人氏の描く美麗なキャラは素晴らしいものがありました", "publisher": "youtan0309", "canonical_url": "https://x.com/youtan0309/status/2125609202596925830", "published_at": "2026-11-25T15:15:00+00:00", "published_at_raw": "Wed, 25 Nov 2026 15:15:00 GMT", "published_precision": "second", "fetched_at": "2026-11-25T15:21:03.140400+00:00", "media": [], "metadata": {"account": "youtan0309", "author_name": "youtan0309", "is_retweet": false, "retweeted_by": null, "is_reply": false, "reply_to": null, "is_quote": false, "quoted_tweet_id": null, "quoted_author": null, "quoted_text": null, "is_pinned": false, "stats": {"replies": null, "retweets": null, "likes": null, "views": null}, "provider": "nitter", "route": "rss"}}
