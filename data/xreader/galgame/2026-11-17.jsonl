{"identity_key": "x:2122345195106902027", "source_id": "x", "item_id": "2122345195106902027", "title": null, "content": "3年前の本日は ヒラヒラヒヒル (ANIPLEX.EXE) の発売日でした\n\n\n\nANIPLEX.EXE第3弾\n\n\n\nCARNIVAL,キラ☆キラを手掛けた瀬戸口廉也氏を擁し制作された作品\n\n風爛症という難病と向き合っていく物語\n\nメッセージ性が強くも淡々と進む文学的な読み物\n\n架空の設定をあそこまでリアルに見せるのは本当に凄かったです", "publisher": "youtan0309", "canonical_url": "https://x.com/youtan0309/status/2122345195106902027", "published_at": "2026-11-16T15:05:00+00:00", "published_at_raw": "Mon, 16 Nov 2026 15:05:00 GMT", "published_precision": "second", "fetched_at": "2026-11-16T15:19:44.942333+00:00", "media": [], "metadata": {"account": "youtan0309", "author_name": "youtan0309", "is_retweet": false, "retweeted_by": null, "is_reply": false, "reply_to": null, "is_quote": false, "quoted_tweet_id": null, "quoted_author": null, "quoted_text": null, "is_pinned": false, "stats": {"replies": null, "retweets": null, "likes": null, "views": null}, "provider": "nitter", "route": "rss"}}
