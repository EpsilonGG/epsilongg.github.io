{
  "schema_version": 1,
  "note": "译文术语表。zh 是本站统一写法，avoid 是明确不该出现的写法（同义但会破坏一致性）。改这里等于改全站口径，改完跑 npm run check:glossary。",
  "terms": [
    {
      "ja": "声優",
      "zh": "声优",
      "avoid": [
        "配音员",
        "配音演员"
      ],
      "note": "指职业时用「声优」；「配音」只作动词，不算异形。"
    },
    {
      "ja": "シナリオライター",
      "zh": "编剧",
      "avoid": [
        "剧本家",
        "脚本家"
      ],
      "note": "写游戏剧本的人。轻小说/动画语境可用「作者」，但游戏一律「编剧」。"
    },
    {
      "ja": "シナリオ",
      "zh": "剧本",
      "avoid": [],
      "note": "指文本本身。「脚本」留给程序脚本（スクリプト）。"
    },
    {
      "ja": "スクリプト",
      "zh": "脚本",
      "avoid": [],
      "note": "程序/演出用的代码，不要和「剧本」混。"
    },
    {
      "ja": "原画",
      "zh": "原画",
      "avoid": [
        "原图"
      ],
      "note": "作画环节，保留原词。"
    },
    {
      "ja": "立ち絵",
      "zh": "立绘",
      "avoid": [
        "站姿图"
      ],
      "note": ""
    },
    {
      "ja": "体験版",
      "zh": "体验版",
      "avoid": [
        "试玩版"
      ],
      "note": "商店页语境用「体验版」；「试玩」只作动词。"
    },
    {
      "ja": "発売",
      "zh": "发售",
      "avoid": [],
      "note": "游戏/书籍统一「发售」。"
    },
    {
      "ja": "パブリッシャー",
      "zh": "发行商",
      "avoid": [
        "出版商"
      ],
      "note": "游戏行业语境。"
    },
    {
      "ja": "デベロッパー",
      "zh": "开发商",
      "avoid": [],
      "note": ""
    },
    {
      "ja": "ブランド",
      "zh": "品牌",
      "avoid": [],
      "note": "美少女游戏厂商常自称「品牌」，保留「品牌」。"
    },
    {
      "ja": "インディーゲーム",
      "zh": "独立游戏",
      "avoid": [
        "独立游戏作品"
      ],
      "note": ""
    },
    {
      "ja": "同人",
      "zh": "同人",
      "avoid": [],
      "note": "不译成「粉丝创作」，本站保留原词。"
    },
    {
      "ja": "画集",
      "zh": "画集",
      "avoid": [
        "画册"
      ],
      "note": "和标签「画集」一致。"
    },
    {
      "ja": "インタビュー",
      "zh": "访谈",
      "avoid": [
        "专访（泛称）"
      ],
      "note": "栏目/标题用「访谈」；正文叙述「我们采访了」可用「采访」，那是动作不是体裁。"
    },
    {
      "ja": "ローカライズ",
      "zh": "本地化",
      "avoid": [
        "在地化"
      ],
      "note": "nicolith 访谈的核心概念，全篇统一。"
    },
    {
      "ja": "セリフ",
      "zh": "台词",
      "avoid": [
        "对白"
      ],
      "note": "单人说的话用「台词」，两人往来才用「对白」。"
    },
    {
      "ja": "設定",
      "zh": "设定",
      "avoid": [],
      "note": "作品设定。"
    },
    {
      "ja": "キャラクター",
      "zh": "角色",
      "avoid": [
        "人物（指虚构角色时）"
      ],
      "note": "虚构角色一律「角色」；「人物」只用于现实人物。"
    },
    {
      "ja": "世界観",
      "zh": "世界观",
      "avoid": [],
      "note": ""
    },
    {
      "ja": "演出",
      "zh": "演出",
      "avoid": [
        "导演（游戏语境）"
      ],
      "note": "游戏里的演出指表现手法，不是舞台导演。"
    },
    {
      "ja": "絵コンテ",
      "zh": "分镜",
      "avoid": [
        "故事板"
      ],
      "note": ""
    },
    {
      "ja": "アーリーアクセス",
      "zh": "抢先体验",
      "avoid": [
        "早期访问"
      ],
      "note": "Steam 官方中文用词。"
    },
    {
      "ja": "クラウドファンディング",
      "zh": "众筹",
      "avoid": [
        "云募资"
      ],
      "note": ""
    },
    {
      "ja": "ボイス",
      "zh": "语音",
      "avoid": [
        "声音（指配音素材时）"
      ],
      "note": "「ボイス収録」→「语音收录」。"
    },
    {
      "ja": "二人三脚",
      "zh": "并肩推进",
      "avoid": [
        "二人三脚",
        "两人三足",
        "两个人三只脚"
      ],
      "note": "「二人三脚で開発を進める」→「并肩推进开发」。中文没有这个熟语，照字面写会读成杂技项目。"
    },
    {
      "ja": "相乗効果",
      "zh": "协同效应",
      "avoid": [
        "相乘效果",
        "相乘作用"
      ],
      "note": "数学的「相乘」在中文里不表示 1+1>2。"
    },
    {
      "ja": "爆弾発言",
      "zh": "爆炸性发言",
      "avoid": [
        "炸弹发言"
      ],
      "note": "指可能引爆争议的发言，不是真的炸弹。"
    },
    {
      "ja": "キャッチコピー",
      "zh": "标语",
      "avoid": [
        "宣传口号",
        "广告语"
      ],
      "note": "作品/公司的宣传短句，全站统一「标语」。"
    },
    {
      "ja": "脱出",
      "zh": "逃脱",
      "avoid": [],
      "note": "「脱出ゲーム」「脱出パート」→「逃脱游戏」「逃脱环节」；作品名「極限脱出」保留原样，所以不设 avoid。"
    },
    {
      "ja": "ソムニウム",
      "zh": "梦界",
      "avoid": [
        "Somnium（正文夹英文）"
      ],
      "note": "《AI：梦境档案》的「ソムニウムパート」→「梦界部分」，跟官方中文走。"
    },
    {
      "ja": "ギャルゲー",
      "zh": "美少女游戏",
      "avoid": [
        "Galgame",
        "galgame"
      ],
      "note": "面向男性玩家的恋爱题材游戏，和「乙女ゲー」相对。"
    },
    {
      "ja": "プレスリリース",
      "zh": "新闻稿",
      "avoid": [
        "新闻发布",
        "新闻发布稿"
      ],
      "note": "公司公告体裁，不写成「新闻发布」。"
    },
    {
      "ja": "ノベルゲーム",
      "zh": "视觉小说",
      "avoid": [
        "小说游戏",
        "文字小说"
      ],
      "note": "体裁名，和「美少女游戏」并列时用这个。Aniplex 的 ANIPLEX.EXE 就是按这个说法起的。"
    },
    {
      "ja": "美少女ゲーム",
      "zh": "美少女游戏",
      "avoid": [],
      "note": "品类名，含「ギャルゲー」。具体作品是叙述为主时用「视觉小说」，两者不要混着指同一件事。"
    },
    {
      "ja": "エロゲー",
      "zh": "黄油",
      "avoid": [],
      "note": "口语语境用「黄油」；正式叙述可写「成人游戏」。同一篇里选一个，别混用。"
    },
    {
      "ja": "成人向けゲーム",
      "zh": "成人向游戏",
      "avoid": [
        "成人游戏"
      ],
      "note": "统一写「成人向游戏」。「成人游戏」少了「向」字，口径不统一。"
    },
    {
      "ja": "ビジュアルアーツ",
      "zh": "VisualArts",
      "avoid": [
        "视觉艺术"
      ],
      "note": "公司名，不意译。可简写 VA，首次出现加注说明是 ビジュアルアーツ。"
    },
    {
      "ja": "ライアーソフト",
      "zh": "骗子社",
      "avoid": [],
      "note": "品牌名 Liar-soft。作为文章主题词时译「骗子社」并在首见处加注；只是偶尔提到可保留原名。"
    }
  ]
}
