{
  "schema_version": 1,
  "note": "译文术语表。zh 是本站统一写法，avoid 是明确不该出现的写法（同义但会破坏一致性）。改这里等于改全站口径，改完跑 npm run check:glossary。",
  "terms": [
    { "ja": "声優", "zh": "声优", "avoid": ["配音员", "配音演员"], "note": "指职业时用「声优」；「配音」只作动词，不算异形。" },
    { "ja": "シナリオライター", "zh": "编剧", "avoid": ["剧本家", "脚本家"], "note": "写游戏剧本的人。轻小说/动画语境可用「作者」，但游戏一律「编剧」。" },
    { "ja": "シナリオ", "zh": "剧本", "avoid": [], "note": "指文本本身。「脚本」留给程序脚本（スクリプト）。" },
    { "ja": "スクリプト", "zh": "脚本", "avoid": [], "note": "程序/演出用的代码，不要和「剧本」混。" },
    { "ja": "原画", "zh": "原画", "avoid": ["原图"], "note": "作画环节，保留原词。" },
    { "ja": "立ち絵", "zh": "立绘", "avoid": ["站姿图"], "note": "" },
    { "ja": "体験版", "zh": "体验版", "avoid": ["试玩版"], "note": "商店页语境用「体验版」；「试玩」只作动词。" },
    { "ja": "発売", "zh": "发售", "avoid": [], "note": "游戏/书籍统一「发售」。" },
    { "ja": "パブリッシャー", "zh": "发行商", "avoid": ["出版商"], "note": "游戏行业语境。" },
    { "ja": "デベロッパー", "zh": "开发商", "avoid": [], "note": "" },
    { "ja": "ブランド", "zh": "品牌", "avoid": [], "note": "美少女游戏厂商常自称「品牌」，保留「品牌」。" },
    { "ja": "インディーゲーム", "zh": "独立游戏", "avoid": ["独立游戏作品"], "note": "" },
    { "ja": "同人", "zh": "同人", "avoid": [], "note": "不译成「粉丝创作」，本站保留原词。" },
    { "ja": "画集", "zh": "画集", "avoid": ["画册"], "note": "和标签「画集」一致。" },
    { "ja": "インタビュー", "zh": "访谈", "avoid": ["专访（泛称）"], "note": "栏目/标题用「访谈」；正文叙述「我们采访了」可用「采访」，那是动作不是体裁。" },
    { "ja": "ローカライズ", "zh": "本地化", "avoid": ["在地化"], "note": "nicolith 访谈的核心概念，全篇统一。" },
    { "ja": "セリフ", "zh": "台词", "avoid": ["对白"], "note": "单人说的话用「台词」，两人往来才用「对白」。" },
    { "ja": "設定", "zh": "设定", "avoid": [], "note": "作品设定。" },
    { "ja": "キャラクター", "zh": "角色", "avoid": ["人物（指虚构角色时）"], "note": "虚构角色一律「角色」；「人物」只用于现实人物。" },
    { "ja": "世界観", "zh": "世界观", "avoid": [], "note": "" },
    { "ja": "演出", "zh": "演出", "avoid": ["导演（游戏语境）"], "note": "游戏里的演出指表现手法，不是舞台导演。" },
    { "ja": "絵コンテ", "zh": "分镜", "avoid": ["故事板"], "note": "" },
    { "ja": "アーリーアクセス", "zh": "抢先体验", "avoid": ["早期访问"], "note": "Steam 官方中文用词。" },
    { "ja": "クラウドファンディング", "zh": "众筹", "avoid": ["云募资"], "note": "" },
    { "ja": "ボイス", "zh": "语音", "avoid": ["声音（指配音素材时）"], "note": "「ボイス収録」→「语音收录」。" }
  ]
}
