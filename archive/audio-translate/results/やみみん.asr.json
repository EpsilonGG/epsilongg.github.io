 {
  "start": 398.82,
  "end": 400.82,
  "text": "もうみて"
 },
 {
  "start": 400.82,
  "end": 407.9,
  "text": "何か一つなし得たいよね"
 },
 {
  "start": 407.9,
  "end": 414.5,
  "text": "別に終わらないけど私の数を"
 },
 {
  "start": 414.5,
  "end": 417.14,
  "text": "ノンビでやったっていいのかもしれないけど"
 },
 {
  "start": 417.14,
  "end": 419.82,
  "text": "でもノンビリやるって何なんだ?"
 },
 {
  "start": 419.82,
  "end": 422.92,
  "text": "だからね考えたの"
 },
 {
  "start": 427.74,
  "end": 438.56,
  "text": "まだ収録入れるのも絶対推薦だけにしようと思ってさ"
 },
 {
  "start": 439.96,
  "end": 442.4,
  "text": "あのまだまだ"
 },
 {
  "start": 442.4,
  "end": 448.26,
  "text": "やってないけども私したら"
 },
 {
  "start": 448.26,
  "end": 451.2,
  "text": "絶対水金だけにして"
 },
 {
  "start": 451.2,
  "end": 451.22,
  "text": "月曜日はニコナマの配信"
 },
 {
  "start": 451.22,
  "end": 455.18,
  "text": "でも私用日はニコナマの配信"
 },
 {
  "start": 459.4,
  "end": 467.94,
  "text": "いつも見失うYouTuberの人みたいに"
 },
 {
