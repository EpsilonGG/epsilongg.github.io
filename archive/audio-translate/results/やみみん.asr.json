  "text": "みんなぞきゃ謎の"
 },
 {
  "start": 256.34,
  "end": 263.58,
  "text": "なんかさあたしのことをいいよってくれる人が"
 },
 {
  "start": 267.06,
  "end": 269.06,
  "text": "たまに本当に意味が分からないっているより"
 },
 {
  "start": 269.06,
  "end": 282.72,
  "text": "なぜだみた"
 },
 {
  "start": 284.04,
  "end": 287.78,
  "text": "いな"
 },
 {
  "start": 287.78,
  "end": 290.78,
  "text": "私も配信もうまく続けられないし物事をそもそもそも言うことを"
 },
 {
  "start": 290.78,
  "end": 296.78,
  "text": "うまく続けられないし物事をそもそも継続する力が"
 },
 {
  "start": 296.78,
  "end": 302.38,
  "text": "やりたいことはいっぱいあったはずなのに気がつくと"
 },
 {
  "start": 302.38,
