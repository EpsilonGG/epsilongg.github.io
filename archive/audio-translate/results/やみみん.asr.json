 },
 {
  "start": 349.5,
  "end": 352.88,
  "text": "歌はねやってみようと思って今回やってみるけど"
 },
 {
  "start": 360.88,
  "end": 365.04,
  "text": "力不足に感じる"
 },
 {
  "start": 365.04,
  "end": 366.46,
  "text": "誰も自分からすごい人も"
 },
 {
  "start": 366.46,
  "end": 371.38,
  "text": "すごい人もいないよね"
 },
 {
  "start": 371.38,
  "end": 382.6,
  "text": "私も初めからすごい人はいないよね"
 },
 {
  "start": 382.6,
  "end": 382.64,
  "text": "もさあじめからすごい人もいないよね"
 },
 {
  "start": 391.1,
  "end": 398.82,
  "text": "私このままダメなまま置いちゃうんだよ"
