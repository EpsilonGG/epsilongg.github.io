 },
 {
  "start": 217.02,
  "end": 222.66,
  "text": "軽いバッグの中身を出したんだよね"
 },
 {
  "start": 236.68,
  "end": 239.68,
  "text": "いろんなものが散らがってしまう結論に"
 },
 {
  "start": 239.68,
  "end": 245.68,
  "text": "いや聞いて最近なんかね"
