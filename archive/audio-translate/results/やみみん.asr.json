  "text": "気がつくと大体が絞んでいってしまっている"
 },
 {
  "start": 312.88,
  "end": 316.58,
  "text": "継続を身につけられないから"
 },
 {
  "start": 316.58,
  "end": 318.94,
  "text": "常に申し訳ない"
 },
 {
  "start": 325.92,
  "end": 331.9,
  "text": "私は提供できる立場に"
 },
 {
  "start": 333.18,
  "end": 334.5,
