 },
 {
  "start": 246.68,
  "end": 249.84,
  "text": "私のことをいいよって言ってくれる人が"
 },
 {
  "start": 249.84,
  "end": 251.84,
  "text": "みんなが"
 },
 {
  "start": 251.84,
