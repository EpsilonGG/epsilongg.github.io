 {
  "start": 1049.0,
  "end": 1054.62,
  "text": "私は手についてないから"
 },
 {
  "start": 1054.62,
  "end": 1061.62,
  "text": "すごい気を使われた話が分かれてる"
 },
 {
  "start": 1061.62,
  "end": 1073.3,
  "text": "私は手についてないから"
 },
 {
  "start": 1086.0,
  "end": 1089.0,
  "text": "お店はあったに譲るから"
 },
 {
  "start": 1089.0,
  "end": 1091.0,
  "text": "お兄ちゃんはこっちの不動産と"
 },
 {
  "start": 1091.0,
  "end": 1092.3,
  "text": "私"
 },
 {
  "start": 1094.08,
  "end": 1095.4,
  "text": "は"
 },
 {
  "start": 1099.3,
  "end": 1103.82,
  "text": "まあ特"
 },
 {
  "start": 1105.5,
  "end": 1112.3,
  "text": "に希望はな"
 },
 {
  "start": 1114.5,
  "end": 1117.54,
  "text": "いので"
 },
 {
  "start": 1124.56,
  "end": 1130.26,
  "text": "私は身ごわれてるから自分の食い口はなんとか自分で稼ぐし"
 },
 {
  "start": 1130.26,
  "end": 1134.54,
  "text": "そんなのいらったらこれだけ掛かってるからそのがお兄ちゃんねって"
 },
 {
  "start": 1136.16,
  "end": 1137.6,
  "text": "そういう話をしてさ"
 },
 {
  "start": 1137.6,
  "end": 1139.76,
  "text": "そういう話はそうかお店は私なのかね"
 },
 {
  "start": 1139.76,
  "end": 1143.34,
  "text": "そういうさ"
 },
 {
  "start": 1143.34,
  "end": 1145.92,
  "text": "あなたは海外留学行かせて"
 },
 {
  "start": 1145.92,
  "end": 1147.82,
  "text": "ここ大学だったでしょって"
 },
 {
  "start": 1147.82,
  "end": 1149.4,
  "text": "でもこれだけかかってるから"
 },
 {
  "start": 1149.4,
  "end": 1150.88,
  "text": "そのかお兄ちゃんねって"
 },
 {
  "start": 1150.88,
  "end": 1152.18,
  "text": "そういう話をしてさ"
 },
 {
  "start": 1152.18,
  "end": 1155.72,
  "text": "私は"
 },
 {
  "start": 1155.72,
  "end": 1157.78,
  "text": "お店はお店は私は"
 },
 {
  "start": 1157.78,
  "end": 1165.86,
  "text": "お店は私で働いたことないからそりゃそうなんだけど"
 },
 {
  "start": 1165.86,
  "end": 1168.1,
  "text": "でも私経営とかできないよ"
 },
 {
  "start": 1174.52,
  "end": 1177.92,
  "text": "お母さんは経営とかできないよって話を"
 },
 {
  "start": 1179.46,
  "end": 1182.46,
  "text": "皆さんご存じ数字に弱いからね"
 },
 {
  "start": 1182.46,
  "end": 1183.86,
  "text": "そしたら"
 },
 {
  "start": 1183.86,
  "end": 1186.46,
  "text": "そこはお兄ちゃんにやってもらお兄ちゃんって"
 },
 {
  "start": 1186.46,
  "end": 1191.1,
  "text": "お兄ちゃんはお兄ちゃんで"
 },
 {
  "start": 1191.1,
  "end": 1193.02,
  "text": "はい"
 },
 {
  "start": 1194.82,
  "end": 1200.6,
  "text": "お前らそのお店のことは頼むよみたいな言われて"
 },
 {
  "start": 1200.6,
  "end": 1204.96,
  "text": "はいったとたの?"
 },
 {
  "start": 1208.66,
  "end": 1216.1,
  "text": "いや嫌とかじゃなくて"
 },
 {
  "start": 1216.1,
  "end": 1221.64,
  "text": "みんな心配してくれてるんだなと思って"
 },
 {
  "start": 1223.48,
  "end": 1226.34,
  "text": "私の無職だから"
 },
 {
  "start": 1226.34,
  "end": 1230.34,
  "text": "あんまりにも無職然としてるから"
 },
 {
  "start": 1234.04,
  "end": 1239.84,
  "text": "っていうのがねえ"
 },
 {
  "start": 1243.04,
  "end": 1245.6,
  "text": "いい産とか難しい"
 },
 {
  "start": 1245.6,
  "end": 1248.28,
  "text": "とにかく私何度も言ってるのが"
 },
 {
  "start": 1248.28,
  "end": 1251.46,
  "text": "お母さんの家族っていうのかな"
 },
 {
  "start": 1251.46,
  "end": 1253.86,
  "text": "お母さんのお兄ちゃんとケンカしてたの"
 },
 {
  "start": 1253.86,
  "end": 1257.74,
  "text": "それだったらもう全部いらないですって"
 },
 {
  "start": 1257.74,
  "end": 1261.78,
  "text": "お金はねえさんのことで"
 },
 {
  "start": 1261.78,
  "end": 1265.32,
  "text": "その時のお母さんを見るのがすごいつらくて"
 },
 {
  "start": 1265.32,
  "end": 1268.04,
  "text": "お兄ちゃんとケンカはしたくないです"
 },
 {
  "start": 1275.14,
  "end": 1277.58,
  "text": "そうなんだけど"
 },
 {
  "start": 1277.58,
  "end": 1281.14,
  "text": "お金で喧嘩をしたくないです"
 },
 {
  "start": 1282.94,
  "end": 1284.8,
  "text": "分かるんでしょう"
 },
 {
  "start": 1284.8,
  "end": 1286.32,
  "text": "嫌なんだよね"
 },
 {
  "start": 1286.32,
  "end": 1286.34,
  "text": "嫌なんだよね"
 },
 {
  "start": 1286.34,
  "end": 1290.34,
  "text": "悲しいよね"
 },
 {
  "start": 1290.34,
  "end": 1291.22,
  "text": "きっとね"
 },
 {
  "start": 1291.22,
  "end": 1299.28,
  "text": "そういうことを話したんだよね"
 },
 {
  "start": 1299.28,
  "end": 1302.3,
  "text": "まあ"
 },
 {
  "start": 1302.3,
  "end": 1306.28,
  "text": "ゆいもん衣装とかがあるわけじゃないからさ"
 },
 {
  "start": 1306.28,
  "end": 1308.98,
  "text": "お話をしただけに"
 },
 {
  "start": 1308.98,
  "end": 1313.4,
  "text": "もうちょっとちゃんとせんとなと思った"
 },
 {
  "start": 1313.4,
  "end": 1319.32,
  "text": "親友としても犯人前だからさ"
 },
 {
  "start": 1319.32,
  "end": 1326.64,
  "text": "もっとなんか安心させられるような"
 },
 {
  "start": 1332.26,
  "end": 1335.16,
  "text": "人生動かしていかなきゃいけないな"
 },
 {
  "start": 1337.08,
  "end": 1339.3,
  "text": "ねえ"
 },
 {
  "start": 1339.3,
  "end": 1341.48,
  "text": "配信の仕事も定期的にやるとか"
 },
 {
  "start": 1341.48,
  "end": 1341.58,
  "text": "いや"
 },
 {
  "start": 1341.58,
  "end": 1343.04,
  "text": "いや"
 },
 {
  "start": 1343.04,
  "end": 1344.18,
  "text": "アーってやって"
 },
 {
  "start": 1344.18,
  "end": 1346.46,
  "text": "配信の基準をつけたいし"
 },
 {
  "start": 1347.94,
  "end": 1349.461,
  "text": "親友の仕事も"
 },
 {
  "start": 1349.461,
  "end": 1354.24,
  "text": "ねえっとやってやって"
 },
 {
  "start": 1356.7,
  "end": 1361.241,
  "text": "スケジュール詰めて"
 },
 {
  "start": 1361.241,
  "end": 1361.261,
  "text": "スケジュールつめて"
 },
 {
  "start": 1361.261,
  "end": 1364.901,
  "text": "私はそのまま一回やめますってやめて"
 },
 {
  "start": 1364.901,
  "end": 1367.701,
  "text": "またウォーッとおりかしちゃう"
 },
 {
  "start": 1367.701,
  "end": 1375.801,
  "text": "ただもうここまで見守ってくだったみんなはよしっとると思うけど"
 },
 {
  "start": 1375.801,
  "end": 1378.241,
  "text": "私はそんな生き方をしてるんだけど"
 },
 {
  "start": 1378.241,
  "end": 1378.4,
  "text": "だ"
 },
 {
  "start": 1380.1,
  "end": 1383.46,
  "text": "からね"
 },
 {
  "start": 1395.761,
  "end": 1403.061,
  "text": "ただねなんか思ったんだけど"
 },
 {
  "start": 1403.061,
  "end": 1407.701,
  "text": "もちろん上を見るのも大事なんだけど"
 },
 {
  "start": 1407.701,
  "end": 1414.601,
  "text": "自分が精進していくのも成長していくのも"
 },
 {
  "start": 1414.601,
  "end": 1416.601,
  "text": "必要なことだと思うんだけど"
 },
 {
  "start": 1416.601,
  "end": 1423.9,
  "text": "でもねないものを必要に求めるのも違うよなと思って"
 },
 {
  "start": 1427.62,
  "end": 1432.161,
  "text": "私が配信者として名乗るにも"
 },
 {
  "start": 1432.161,
  "end": 1436.521,
  "text": "声優として名乗るにも"
 },
 {
  "start": 1436.521,
  "end": 1438.261,
  "text": "声優はギリでいけるか"
 },
 {
  "start": 1438.261,
  "end": 1442.861,
  "text": "今だけやってきてるから"
 },
 {
  "start": 1442.861,
  "end": 1445.021,
  "text": "作用の問題なのかな"
 },
 {
  "start": 1445.021,
  "end": 1445.061,
  "text": "まだ"
 },
 {
  "start": 1445.061,
  "end": 1453.361,
  "text": "求めるのが違うのかもなと思ったりしてる"
 },
 {
  "start": 1453.361,
  "end": 1462.401,
  "text": "んだけやってきてるから"
 },
 {
  "start": 1470.801,
  "end": 1473.801,
  "text": "でもみんなとしゃべりたいんだよ"
 },
 {
  "start": 1473.801,
  "end": 1476.801,
  "text": "さっきと言ったり来たりしてる話が"
 },
 {
  "start": 1476.801,
  "end": 1478.801,
  "text": "はい"
 },
 {
  "start": 1478.801,
  "end": 1480.941,
  "text": "はい"
 },
 {
  "start": 1480.941,
  "end": 1482.341,
  "text": "本ではここら辺で"
 },
 {
  "start": 1482.341,
  "end": 1485.941,
  "text": "部屋ちょっと片付いたよ"
 },
 {
  "start": 1485.941,
  "end": 1497.601,
  "text": "ありがとうね"
 },
 {
  "start": 1497.601,
  "end": 1497.981,
  "text": "今日はここら辺で"
 },
 {
  "start": 1497.981,
  "end": 1500.081,
  "text": "ちょっとちょっと待っててよりかたくてております"
 }
]