[
 {
  "start": 0.06,
  "end": 1.88,
  "text": "んー"
 },
 {
  "start": 6.04,
  "end": 14.62,
  "text": "んふふふんーんふふふなんか今日空気清浄機が"
 },
 {
  "start": 16.44,
  "end": 22.06,
  "text": "めちゃくちゃ鳴っていやー"
 },
 {
  "start": 22.74,
  "end": 28.16,
  "text": "久しぶりですえーちょっと痛い"
 },
 {
  "start": 29.46,
  "end": 30.52,
  "text": "なんかねー"
 },
 {
  "start": 31.7,
  "end": 34.2,
  "text": "空気清浄機止めよう止めよう止めよう"
 },
 {
  "start": 38.4,
  "end": 40.96,
  "text": "なんでこんな今日になってんの君"
 },
 {
  "start": 45.72,
  "end": 47.64,
  "text": "やばいんだよ"
 },
 {
  "start": 54.3,
  "end": 56.0,
  "text": "はいちょっと待って待って"
 },
 {
  "start": 59.44,
  "end": 62.5,
  "text": "まず、まずやることやろうなよしよし"
 },
 {
  "start": 64.14,
  "end": 65.18,
  "text": "えーっと"
 },
 {
  "start": 65.94,
  "end": 67.08,
  "text": "ちょっと待ってね"
 },
 {
  "start": 69.3,
  "end": 70.34,
  "text": "えーっと"
 },
 {
  "start": 79.61,
  "end": 82.4,
  "text": "ネットプリントしなきゃいけないから"
 },
 {
  "start": 85.56,
  "end": 87.22,
  "text": "ネットプリントしようかな"
 },
 {
  "start": 88.66,
  "end": 89.72,
  "text": "準備しようかな"
 },
 {
  "start": 93.96,
  "end": 100.0,
  "text": "えーっとえっと、どこだっけ?\nこれかな?"
 },
 {
  "start": 105.22,
  "end": 106.49,
  "text": "えーっと、"
 },
 {
  "start": 114.02,
  "end": 122.06,
  "text": "これと"
 },
 {
  "start": 125.6,
  "end": 126.88,
  "text": "あと一個"
 },
 {
  "start": 146.96,
  "end": 148.94,
  "text": "ちょっと待って、落ち着け私"
 },
 {
  "start": 160.18,
  "end": 161.82,
  "text": "はいはいはいはい"
 },
 {
  "start": 166.0,
  "end": 171.54,
  "text": "よし\nよしとこれで大丈夫ほんで着替えます"
 },
 {
  "start": 172.22,
  "end": 174.56,
  "text": "よろしいか着替えましょう"
 },
 {
  "start": 175.72,
  "end": 177.2,
  "text": "いやーあのね"
 },
 {
  "start": 179.84,
  "end": 181.88,
  "text": "何が厳しいかって"
 },
 {
  "start": 184.14,
  "end": 188.78,
  "text": "ちょっと\n皆さんご存知体調が崩し"
 },
 {
  "start": 190.34,
  "end": 192.6,
  "text": "体調を崩し"
 },
 {
  "start": 193.74,
  "end": 195.64,
  "text": "その用語が良くない"
 },
 {
  "start": 196.56,
  "end": 198.02,
  "text": "待って待って待って"
 },
 {
  "start": 198.7,
  "end": 200.82,
  "text": "用語だけじゃないよ"
 },
 {
  "start": 203.44,
  "end": 206.74,
  "text": "あの子やばいのメンタルがもう"
 },
 {
  "start": 207.32,
  "end": 211.96,
  "text": "もうすぐライブに今回のねライブはね"
 },
 {
  "start": 212.98,
  "end": 219.96,
  "text": "今回のライブはできるだけ楽しくやろうって決めてたのに"
 },
 {
  "start": 221.97,
  "end": 224.92,
  "text": "楽しい非常にプレッシャーが混ざり"
 },
 {
  "start": 227.34,
  "end": 233.5,
  "text": "ひどいとこで風邪ひいたもんだからすっかり自信がなくなり"
 },
 {
  "start": 235.52,
  "end": 243.16,
  "text": "いやでもみんなと会えるのは楽しみそれを楽しみだけにその日が来れば"
 },
 {
  "start": 243.16,
  "end": 246.2,
  "text": "もうどうにかなるだってみんな優しいし"
 },
 {
  "start": 255.28,
  "end": 257.22,
  "text": "今日は\nス"
 },
 {
  "start": 259.6,
  "end": 264.24,
  "text": "タジオさんに行って忘れ物を取りに行ってから"
 },
 {
  "start": 264.8,
  "end": 266.5,
  "text": "ボイトレ行って"
 },
 {
  "start": 269.26,
  "end": 273.04,
  "text": "ラオケ行って練習して帰ってくる"
 },
 {
  "start": 280.47,
  "end": 281.62,
  "text": "そんな感じ"
 },
 {
  "start": 282.34,
  "end": 284.2,
  "text": "ほんでほんでほんで"
 },
 {
  "start": 291.48,
  "end": 297.42,
  "text": "何が何かって言うとご飯が食べられなくなっちゃって"
 },
 {
  "start": 299.46,
  "end": 302.38,
  "text": "ご飯が食べられない"
 },
 {
  "start": 303.0,
  "end": 308.72,
  "text": "ご飯にも食べられない"
 },
 {
  "start": 311.3,
  "end": 315.6,
  "text": "食べ過ぎよりかはいいのかなと思ってたけど食べ過ぎの方がまだいい気"
 },
 {
  "start": 315.6,
  "end": 318.2,
  "text": "がしてきた気合う"
 },
 {
  "start": 318.96,
  "end": 320.24,
  "text": "気合う"
 },
 {
  "start": 322.4,
  "end": 324.56,
  "text": "弱い人間である"
 },
 {
  "start": 325.96,
  "end": 327.88,
  "text": "前に進めない"
 },
 {
  "start": 334.5,
  "end": 340.96,
  "text": "楽しみにしてくださっている皆様に申し訳ない"
 },
 {
  "start": 346.74,
  "end": 347.78,
  "text": "りあえず"
 },
 {
  "start": 349.16,
  "end": 351.18,
  "text": "現場に当日行けばいい"
 },
 {
  "start": 352.44,
  "end": 355.92,
  "text": "そしたらそしたら絶対楽しいん"
 },
 {
  "start": 358.6,
  "end": 360.7,
  "text": "着替えろ着替えろ"
 },
 {
  "start": 361.84,
  "end": 362.98,
  "text": "替えろ"
 },
 {
  "start": 364.54,
  "end": 366.58,
  "text": "んん"
 },
 {
  "start": 371.58,
  "end": 374.16,
  "text": "えっとなんでに入ってるんだ"
 },
 {
  "start": 375.5,
  "end": 380.46,
  "text": "んんんん"
 },
 {
  "start": 387.78,
  "end": 393.98,
  "text": "ごめん\n遠"
 },
 {
  "start": 398.76,
  "end": 401.38,
  "text": "くで赤ちゃんが泣いてるかわいい"
 },
 {
  "start": 416.74,
  "end": 419.64,
  "text": "しばし私と時に浸ろう"
 },
 {
  "start": 433.8,
  "end": 439.44,
  "text": "不\n甲斐なくて申し訳ない"
 },
 {
  "start": 445.74,
  "end": 449.74,
  "text": "悩みのない人生ならばよかった"
 },
 {
  "start": 461.4,
  "end": 461.83,
  "text": "本当"
 },
 {
  "start": 475.56,
  "end": 480.94,
  "text": "はこんなことを言っちゃいけないのかもしれないなと思いつつ言ってしま"
 },
 {
  "start": 480.94,
  "end": 482.0,
  "text": "ってごめんなさい"
 },
 {
  "start": 484.84,
  "end": 489.76,
  "text": "なあ場所なんですなあ場所なあ場所だなあ"
 },
 {
  "start": 492.36,
  "end": 498.26,
  "text": "分自身を立ち上げられないよ頑張れ立って立つんだ着替えろ"
 },
 {
  "start": 510.96,
  "end": 513.22,
  "text": "っていう感じの毎日です"
 },
 {
  "start": 515.22,
  "end": 524.22,
  "text": "いや頑張ってるんだよって言いたかったけどダメだ"
 },
 {
  "start": 524.96,
  "end": 526.34,
  "text": "ダメである"
 },
 {
  "start": 528.22,
  "end": 533.0,
  "text": "いやマジでなんでみんなこんな私のこと好きでいてくれるんだ"
 },
 {
  "start": 534.04,
  "end": 537.82,
  "text": "ありえないことないんだけど"
 },
 {
  "start": 540.1,
  "end": 542.14,
  "text": "いや優しいな"
 },
 {
  "start": 544.18,
  "end": 554.9,
  "text": "いいかい私はまだまだこれからもダメなとこを見せるけどして"
 },
 {
  "start": 554.92,
  "end": 560.62,
  "text": "ないでくださいください、してないでー"
 },
 {
  "start": 575.32,
  "end": 579.56,
  "text": "いつも言ってる気がしてきた\n立"
 },
 {
  "start": 582.4,
  "end": 583.46,
  "text": "ち上がるぞ"
 },
 {
  "start": 586.44,
  "end": 587.86,
  "text": "メだ立ち上がれぬ"
 },
 {
  "start": 589.89,
  "end": 591.14,
  "text": "立ち上がるんだ"
 },
 {
  "start": 593.7,
  "end": 601.28,
  "text": "嫌だ立ち上がりたくないまいった"
 },
 {
  "start": 642.15,
  "end": 643.36,
  "text": "よいしょ"
 },
 {
  "start": 678.74,
  "end": 690.46,
  "text": "んんん"
 },
 {
  "start": 690.58,
  "end": 714.3,
  "text": "んんんんんんんんんんんんんんんん"
 },
 {
  "start": 714.44,
  "end": 745.44,
  "text": "んんんんんんんんんんんんんんんんんんんんんんんん"
 },
 {
  "start": 745.44,
  "end": 745.92,
  "text": "んんんんんんんんんんんんんんんんんんんんんんんんんんんんんんんん\nんんんんんんんんんんんんんんんんんんんんんんんんんんんんんんんん\nんんんんんんんんんんんんんんんんんんんんんんんんんんんんんんんん"
 },
 {
  "start": 745.92,
  "end": 758.78,
  "text": "んんんんんんんんんんんんんんんんんん"
 },
 {
  "start": 759.06,
